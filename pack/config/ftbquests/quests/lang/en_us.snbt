{
	chapter.1B00000000000000.title: "Hands and Stone"
	chapter.1C00000000000000.title: "Dark Arts"
	chapter.2B00000000000000.title: "Kinetic Language"
	chapter.2C00000000000000.title: "Glyph and Gloom"
	chapter.3B00000000000000.title: "Ash and Twilight"
	chapter.4B00000000000000.title: "Echo and Below"
	chapter.5B00000000000000.title: "Concordance"
	chapter.6B00000000000000.title: "The Nether"
	chapter.7B00000000000000.title: "God of War"
	quest.1B00000000000001.quest_desc: ["Punch trees. Gather 8 logs of any natural wood - plain in-world logs only; stripped and other variants do not count."]
	quest.1B00000000000001.title: "Get wood"
	quest.1B00000000000002.quest_desc: ["Craft a Small Wooden Slate from 4 planks in your 2x2 grid, then hold it and carve a tool head. There is no crafting table yet - shape comes before the grid."]
	quest.1B00000000000002.title: "A blank of wood"
	quest.1B00000000000003.quest_desc: ["A Small Wooden Slate plus a Stick makes the Opening Mallet - your bootstrap finalizer. Nearly every early world-interaction is a mallet strike."]
	quest.1B00000000000003.title: "The Opening Mallet"
	quest.1B00000000000004.quest_desc: ["Hold 3+ Sugar Cane with the Mallet in your offhand and strike a block touching water while carrying two Small Wooden Slates. Paper feeds the Slag blueprints."]
	quest.1B00000000000004.title: "Pressed against water"
	quest.1B00000000000005.quest_desc: ["3 Paper + 1 Clay Ball = a Slag Modular Blueprint. Insert a carved head and two sticks, then shift-use to assemble your first real tools."]
	quest.1B00000000000005.title: "Modular blueprints"
	quest.1B00000000000006.quest_desc: ["Carve a Wooden Helmet from a Big Wooden Slate. Carving yields the wearable Immersive Armors piece itself; no blueprint assembly."]
	quest.1B00000000000006.title: "Wooden helmet"
	quest.1B00000000000007.quest_desc: ["Carve a wooden pickaxe head from a slate. The quest ticks the head; socket it into a Modular Blueprint with two sticks and shift-use to finish the pickaxe."]
	quest.1B00000000000007.title: "Wooden pickaxe"
	quest.1B00000000000008.quest_desc: ["Wood cannot break Arcane Crystal or Redstone. Carve a FLINT or a BONE pickaxe head - either one is the copper tier that mines them before iron."]
	quest.1B00000000000008.title: "A harder head"
	quest.1B00000000000009.quest_desc: ["Strike water-touching Dirt with the Mallet for Mud. Mud + Wheat = Packed Mud; four Packed Mud = Mud Bricks. You need about 19."]
	quest.1B00000000000009.title: "Mud into brick"
	quest.1B0000000000000A.quest_desc: ["Lay a 3x3 ring of Mud Bricks around an UNLIT campfire, put 4 stripped logs directly above the corners, and strike a ring brick with the Mallet. The forge ignites by friction - then stand close and look at the lit forge to complete this."]
	quest.1B0000000000000A.title: "The Brick Forge"
	quest.1B0000000000000B.quest_desc: ["Iron hides in the dark. Take your copper-tier pickaxe below, find it, and bring back an ingot - the old world still runs on it."]
	quest.1B0000000000000B.title: "Find me"
	quest.1B0000000000000C.quest_desc: ["The Melter's own alloy: reduce and cast Deep Alloy. It is the backbone of the Stonecutter and the tools above stone."]
	quest.1B0000000000000C.title: "Deep Alloy"
	quest.1B0000000000000D.quest_desc: ["Not the vanilla three-block recipe: 2 Iron Ingots and 1 Deep Alloy over 2 Smooth Stone, in your 2x2 grid. It cuts every darkstone block you are about to need."]
	quest.1B0000000000000D.title: "The Stonecutter"
	quest.1B0000000000000E.quest_desc: ["Armageddon's summon for its first boss. Double-smelt an Iron Ingot with any small flower on the Brick Forge, then right-click the Remote to call the Iron Colossus down on your head. (The stock 3x3 still works once you have a table.)"]
	quest.1B0000000000000E.title: "The Iron Remote"
	quest.1B0000000000000F.quest_desc: ["Armageddon's Iron Colossus. Find it and bring it down - iron respects only force."]
	quest.1B0000000000000F.title: "Slay the Iron Colossus"
	quest.1B00000000000010.quest_desc: ["Double-smelt the Colossal Iron Ingot the Colossus left you with a Gold Ingot on the Brick Forge. Right-click the Coin to summon the Goblin Lord - spend it when you are ready to fight."]
	quest.1B00000000000010.title: "Strange Coin"
	quest.1B00000000000011.quest_desc: ["Spend the Strange Coin and slay the Goblin Lord it summons, along with his little court."]
	quest.1B00000000000011.title: "Slay the Goblin Lord"
	quest.1B00000000000012.quest_desc: ["Smelt or cast Gold. Rose gold and the divine Deorum both begin here."]
	quest.1B00000000000012.title: "Gold Ingot"
	quest.1B00000000000013.quest_desc: ["Smelt Copper - the other half of rose gold."]
	quest.1B00000000000013.title: "Copper Ingot"
	quest.1B00000000000014.quest_desc: ["Alloy Copper and Gold into Rose Gold (Slag). It feeds the Deorum nugget and the serpent-scale plates."]
	quest.1B00000000000014.title: "Rose Gold Ingot"
	quest.1B00000000000015.quest_desc: ["With a copper-tier pickaxe, mine Arcane Crystal Ore. The crystal is the root of the whole arcane line."]
	quest.1B00000000000015.title: "Arcane Crystal"
	quest.1B00000000000016.quest_desc: ["Smelt Arcane Crystals in the Brick Forge - two crystals grind into one dust. (No more free dust from a mallet strike.)"]
	quest.1B00000000000016.title: "Arcane Crystal Dust"
	quest.1B00000000000017.quest_desc: ["Shapeless in your 2x2: Arcane Crystal Dust + Phantom Membrane + Redstone + Gunpowder makes one Mundabitur Dust. It awakens darkstone and raises the Forge."]
	quest.1B00000000000017.title: "Mundabitur Dust"
	quest.1B00000000000018.quest_desc: ["Gather at least 78 raw Darkstone - the full T1 Hephaestus Forge bill. (45 Polished for the structure, 9 for the Gilded, 4 for the Chiseled Arcane, and 20 for the eight pedestals.) The Stonecutter turns Darkstone into Polished and all its cut variants."]
	quest.1B00000000000018.title: "Seventy-eight Darkstone"
	quest.1B00000000000019.quest_desc: ["Shapeless: Mundabitur Dust + Rose Gold Ingot + Charcoal + an Arcane Crystal Dust Speck yields one Deorum Nugget. Split one dust into nine Specks in your grid. Four nuggets press into an ingot (2x2)."]
	quest.1B00000000000019.title: "Deorum Nugget"
	quest.1B0000000000001A.quest_desc: ["Cut and shape every piece of the T1 structure: 45 Polished Darkstone, 9 Gilded Chiseled (Polished + Gold Nugget on the forge), 4 Chiseled Arcane, an Arcane Pillar + Wall + Slab for EACH of 8 pedestals - and the Smithing Table core (2 Iron Ingots over 2 Planks in your 2x2). Gilded Chiseled opens the arcane cut-pool; arcane variants need Arcane Crystal Dust."]
	quest.1B0000000000001A.title: "The forge in pieces"
	quest.1B0000000000001B.quest_desc: ["Build the T1 structure per Forbidden Arcanus's Hephaestus Forge layout (check its guide/ponder). At each of the 8 pedestal spots stack an Arcane Polished Darkstone Pillar, Wall, then Slab, and apply Mundabitur Dust to the pillar - the column settles into a Darkstone Pedestal. Set the Smithing Table in the centre and apply Mundabitur Dust to it: the Hephaestus Forge Tier I rises. Rituals use up to 8 inputs - one per pedestal. Stand close and look at the risen Forge to complete this."]
	quest.1B0000000000001B.title: "Raise the Forge"
	quest.1B0000000000001D.quest_desc: ["Bank 64 Iron Ingots for everything ahead."]
	quest.1B0000000000001D.title: "Iron by the block"
	quest.1B0000000000001E.quest_desc: ["Cast 64 Deep Alloy."]
	quest.1B0000000000001E.title: "Deep Alloy stockpile"
	quest.1B0000000000001F.quest_desc: ["Mine 64 Arcane Crystal."]
	quest.1B0000000000001F.title: "A vein of crystal"
	quest.1B00000000000020.quest_desc: ["Press 64 Deorum Ingots - divine gold by the stack."]
	quest.1B00000000000020.title: "Deorum hoard"
	quest.1B00000000000021.quest_desc: ["Bank 64 Gold Ingots."]
	quest.1B00000000000021.title: "Gold stockpile"
	quest.1B00000000000022.quest_desc: ["Bank 64 Copper Ingots."]
	quest.1B00000000000022.title: "Copper stockpile"
	quest.1B00000000000023.quest_desc: ["Alloy 64 Rose Gold Ingots."]
	quest.1B00000000000023.title: "Rose Gold stockpile"
	quest.1B00000000000024.quest_desc: ["Carve a Wooden Chestplate from a Big Wooden Slate."]
	quest.1B00000000000024.title: "Wooden chestplate"
	quest.1B00000000000025.quest_desc: ["Carve Wooden Leggings from a Big Wooden Slate."]
	quest.1B00000000000025.title: "Wooden leggings"
	quest.1B00000000000026.quest_desc: ["Carve Wooden Boots from a Big Wooden Slate. That is the set."]
	quest.1B00000000000026.title: "Wooden boots"
	quest.1B00000000000027.quest_desc: ["Bank 64 Corrupted Arcane Crystal - the soured half of the vein."]
	quest.1B00000000000027.title: "A corrupted vein"
	quest.1B00000000000028.quest_desc: ["Runes come out of the stone in the dark. One of them plus a Glass Bottle is an empty Test Tube."]
	quest.1B00000000000028.title: "A Rune"
	quest.1B00000000000029.quest_desc: ["Glass Bottles now come two-glass at a time off the Brick Forge, so smelt the sand first."]
	quest.1B00000000000029.title: "Glass"
	quest.1B0000000000002A.quest_desc: ["Three Glass into Bottles - the Brick Forge gives two per craft where the stock recipe gives three."]
	quest.1B0000000000002A.title: "Glass Bottles"
	quest.1B0000000000002B.quest_desc: ["A Glass Bottle and a Rune make an empty Test Tube - and Glass Bottles now come two-glass at a time off the Brick Forge. Filling it is the trick: hold the empty tube in your OFFHAND and hit living mobs with your main hand. The tube becomes a blood tube and drinks blood equal to the damage you deal, up to 3000."]
	quest.1B0000000000002B.title: "A Test Tube of Blood"
	quest.1B0000000000002C.quest_desc: ["Ink is what the Forge actually drinks. Bank four Common Ink; every ritual that asks for raw experience is paid in this instead."]
	quest.1B0000000000002C.title: "Common Ink"
	quest.1B0000000000002D.quest_desc: ["Souls drop from the Lost Soul family that drifts through the dark. Lost, Corrupt and Enchanted Souls all count toward this - bring back any four."]
	quest.1B0000000000002D.title: "Get Souls"
	quest.1B0000000000002E.quest_desc: ["Aureal comes bottled, and the Forge fills the bottle for nothing: a ritual on a plain Water Bottle with 4 Arcane Crystal Dust, 2 Rotten Flesh and 2 of any meat - no essence cost, because you cannot spend Aureal you do not have yet. Arcane Crystal Obelisks set into the forge multiblock also generate it passively, forever."]
	quest.1B0000000000002E.title: "Get Aureal"
	quest.1B0000000000002F.quest_desc: ["Leather and string over a chest and a Bundle, in the 2x2 grid. It fits before a crafting table does."]
	quest.1B0000000000002F.title: "A Backpack"
	quest.1B00000000000031.quest_desc: ["A Tier-I ritual on the Copper Backpack: 4 Blocks of Iron, 2 Colossal Iron and 2 Kangaroo Hide, for 5000 blood and 50 aureal. The forge hands the old pack's contents to the new one."]
	quest.1B00000000000031.title: "Iron Backpack"
	quest.1C00000000000008.quest_desc: ["Infuse a single block of DIORITE at the altar with one Sacred and one Arcane spirit. (Was sixteen stone at a time; now one for one.)"]
	quest.1C00000000000008.title: "Tainted Rock"
	quest.1C00000000000009.quest_desc: ["The same trade, soured: one block of GRANITE, one Wicked and one Arcane spirit."]
	quest.1C00000000000009.title: "Twisted Rock"
	quest.1C0000000000000A.quest_desc: ["Build the Crucible - the attuner that grinds spirits into something finer. Malum infuses a Furnace with 2 Hex Ash and 8 of each rock, paid in Infernal and Aqueous spirits."]
	quest.1C0000000000000A.title: "The Spirit Crucible"
	quest.1C0000000000000B.quest_desc: ["One coal, one Infernal spirit, one Arcane Charcoal. (Was four for four.)"]
	quest.1C0000000000000B.title: "Arcane Charcoal"
	quest.1C0000000000000C.quest_desc: ["Gunpowder infused with an Arcane spirit, an Arcane Crystal Dust Speck, one Arcane Charcoal Fragment and one Refined Soulstone."]
	quest.1C0000000000000C.title: "Hex Ash"
	quest.1C0000000000000D.quest_desc: ["Six Clay Balls down to one Calx: a Grim Talc, one Hex Ash, five Bones and three mushrooms of any kind, paid in Arcane, Earthen and Aqueous spirits."]
	quest.1C0000000000000D.title: "Alchemical Calx"
	quest.1C0000000000000E.quest_desc: ["Four Calx, four Earthen and four Aerial spirits, and four each of Hex Ash, Raw Soulstone, Raw Brilliance and Natural Quartz. What comes out is an Alchemical Impetus with just EIGHT durability of its eight hundred - a fraction of the power it could hold. Spend it carefully; when it breaks it leaves a Fractured Impetus behind, not nothing."]
	quest.1C0000000000000E.title: "A fraction of Power"
	quest.1C0000000000000F.quest_desc: ["Focus the Impetus in the Crucible with two Infernal and one Earthen spirit: four Glowstone Dust a cycle. (The stock eight-dust recipe is gone.)"]
	quest.1C0000000000000F.title: "Glowstone Dust"
	quest.1C00000000000012.quest_desc: ["Two pieces in your 2x2: Runewood Planks over an Edelwood Stick, set corner to corner. The staff is how you carve spirit runes into a totem."]
	quest.1C00000000000012.title: "The Totemic Staff"
	quest.1C00000000000015.quest_desc: ["The Catalyzer holds a single Core Augment and feeds its effect to the crucible beside it."]
	quest.1C00000000000015.title: "Spirit Catalyzer"
	quest.1C00000000000016.quest_desc: ["Hold it and every resonance on the Spirit Crucible and its augments becomes visible. Use it ON the crucible to pick one attribute to strengthen - the others weaken to pay for it."]
	quest.1C00000000000016.title: "Tuning Fork"
	quest.1C00000000000017.quest_desc: ["The Pylon mends the gear you leave in its reach, paid for in spirits."]
	quest.1C00000000000017.title: "Repair Pylon"
	quest.1C00000000000019.quest_desc: ["Spirit-infuse an Iron Ingot into Soul-Infused Iron at the altar."]
	quest.1C00000000000019.title: "Soul-Infused Iron"
	quest.1C0000000000001A.quest_desc: ["Spirit-infuse an Iron Ingot into Frost-Infused Iron at the altar."]
	quest.1C0000000000001A.title: "Frost-Infused Iron"
	quest.1C0000000000001B.quest_desc: ["Spirit-infuse an Iron Ingot into Healing-Infused Iron at the altar."]
	quest.1C0000000000001B.title: "Healing-Infused Iron"
	quest.1C0000000000001C.quest_desc: ["Spirit-infuse an Iron Ingot into Lightning-Infused Iron at the altar."]
	quest.1C0000000000001C.title: "Lightning-Infused Iron"
	quest.1C0000000000001D.quest_desc: ["Spirit-infuse an Iron Ingot into Arcane-Infused Iron at the altar."]
	quest.1C0000000000001D.title: "Arcane-Infused Iron"
	quest.1C0000000000001E.quest_desc: ["A Core Augment for the Spirit Catalyzer."]
	quest.1C0000000000001E.title: "Caustic Catalyst"
	quest.1C0000000000001F.quest_desc: ["A Core Augment for the Spirit Catalyzer."]
	quest.1C0000000000001F.title: "Resonance Tuner"
	quest.1C00000000000020.quest_desc: ["A Core Augment for the Spirit Catalyzer."]
	quest.1C00000000000020.title: "Stellar Mechanism"
	quest.1C00000000000021.quest_desc: ["The Arcane-and-Eldritch opposition core. Malum's own notes call it a warning, not a recommendation: Arcane floods into Eldritch and the result is a corruptive explosion that leaves Blight behind."]
	quest.1C00000000000021.title: "Suspicious Device"
	quest.1C00000000000022.quest_desc: ["A Core Augment for the Spirit Catalyzer."]
	quest.1C00000000000022.title: "Sympathy Drive"
	quest.1C00000000000023.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000023.title: "Accelerating Inlay"
	quest.1C00000000000024.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000024.title: "Blazing Diode"
	quest.1C00000000000025.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000025.title: "Impurity Stabilizer"
	quest.1C00000000000026.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000026.title: "Intricate Assembly"
	quest.1C00000000000027.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000027.title: "Mending Diffuser"
	quest.1C00000000000028.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000028.title: "Prismatic Focus Lens"
	quest.1C00000000000029.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C00000000000029.title: "Shielding Apparatus"
	quest.1C0000000000002A.quest_desc: ["An Augment. Up to four sit in the crucible itself; duplicates compound."]
	quest.1C0000000000002A.title: "Warping Engine"
	quest.1C00000000000045.quest_desc: ["At the Spirit Altar, weave 4 Wool with Hex Ash, Spiritual Dust, 5 String and 3 Leather. Sacred, Aerial and Earthen spirits bind it into one Soulwoven Silk."]
	quest.1C00000000000045.title: "Soulwoven Silk"
	quest.1C00000000000046.quest_desc: ["Craft Soulwoven Silk in the centre of a 3x3 grid with 8 Arcane Essence around it."]
	quest.1C00000000000046.title: "Arcane Cloth"
	quest.1C00000000000047.quest_desc: ["Spirit-infuse Arcane Cloth with 2 Soulwoven Silk, 3 Phantom Membranes and 8 String, paid in Sacred, Aerial and Arcane spirits."]
	quest.1C00000000000047.title: "Astral Weave"
	quest.1C00000000000048.quest_desc: ["At the Hephaestus Forge, bind a Bundle with 4 Soulwoven Silk and 4 String for 30 Aureal and 1000 Blood."]
	quest.1C00000000000048.title: "Soulwoven Pouch"
	quest.1C00000000000049.quest_desc: ["At a Tier-I Hephaestus Forge, feed the Soulwoven Pouch 3 Raven Feathers, 2 Soulwoven Silk, Grim Talc and 2 String."]
	quest.1C00000000000049.title: "Ravenous Pouch"
	quest.1C0000000000004A.quest_desc: ["At the Spirit Altar, reforge a Crude Scythe with 2 Dragon Bones, 6 Soulstained Steel Plating, 12 Malignant Lead and 20 Mnemonic Fragments, paid eight of every spirit."]
	quest.1C0000000000004A.title: "Soulstained Steel Scythe"
	quest.1C0000000000004B.quest_desc: ["The first Primitive Refined part that stores rather than turns."]
	quest.1C0000000000004B.title: "Mechanical Grid"
	quest.1C0000000000004C.quest_desc: ["The grid that crafts rather than just stores."]
	quest.1C0000000000004C.title: "Mechanical Crafting Grid"
	quest.1C0000000000004D.quest_desc: ["Reads the network from outside it."]
	quest.1C0000000000004D.title: "External Reader"
	quest.1C0000000000004E.quest_desc: ["Soulstained steel drawn into a shaft - the start of the arcanetic line."]
	quest.1C0000000000004E.title: "Arcanetic Shaft"
	quest.1C0000000000004F.quest_desc: ["An obsidiansteel cogwheel, soulstained."]
	quest.1C0000000000004F.title: "Arcanetic Cog"
	quest.1C00000000000050.quest_desc: ["Turns the drive through a corner."]
	quest.1C00000000000050.title: "Arcanetic Gearbox"
	quest.1C00000000000051.quest_desc: ["The same, stood on end."]
	quest.1C00000000000051.title: "Vertical Arcanetic Gearbox"
	quest.1C00000000000052.quest_desc: ["The line ends here. The Controller is what makes the rest of it a system."]
	quest.1C00000000000052.title: "The Primitive Controller"
	quest.1C00000000000053.quest_desc: ["Bank 64 Diorite. Tainted Rock is made one block at a time, so lay in a stack before you start."]
	quest.1C00000000000053.title: "Sixty-four Diorite"
	quest.1C00000000000054.quest_desc: ["Bank 64 Granite - the other half of the pair. Twisted Rock eats it one block at a time."]
	quest.1C00000000000054.title: "Sixty-four Granite"
	quest.1C00000000000055.quest_desc: ["Grim Talc is ground from Soulstone in the Spirit Crucible. The Calx below it cannot start without one."]
	quest.1C00000000000055.title: "Grim Talc"
	quest.1C00000000000056.quest_desc: ["Press Obsidian into a Sturdy Sheet. The Train Casing at the centre of both Arcanetic Gearboxes is built from them."]
	quest.1C00000000000056.title: "Sturdy Sheet"
	quest.1C00000000000057.quest_desc: ["I shouldn't stick my hand in there."]
	quest.1C00000000000057.title: "Exanimate Essence"
	quest.1C00000000000058.quest_desc: ["Find an Ancient City and go in. Everything past this point is sculk."]
	quest.1C00000000000058.title: "Enter the Ancient City"
	quest.1C00000000000059.quest_desc: ["One Echo Shard out of the city's chests."]
	quest.1C00000000000059.title: "Echo Shard"
	quest.1C0000000000005A.quest_desc: ["Soul-Infused Iron at the corners, an Ancient Knowledge Fragment either side, a Sculk Shrieker above and a Bound Soul Ingot below, around a Double Compressed Crafting Table."]
	quest.1C0000000000005A.title: "Sculk Crafting Table"
	quest.1C0000000000005B.quest_desc: ["On the Sculk table: an Amethyst Cluster, an Ignitium Ingot and a Divine Soulshard over Totemic Gold, Dragon Scales and Deep Alloy. It only works at night, and only under open sky or in a lush cave."]
	quest.1C0000000000005B.title: "The Altar of Amethyst"
	quest.2B00000000000001.quest_desc: ["Mine and gather 16 Raw Zinc - the alloy metal Create runs on."]
	quest.2B00000000000001.title: "Zinc from the hills"
	quest.2B00000000000002.quest_desc: ["Mine 64 Andesite. The bulk of every early machine."]
	quest.2B00000000000002.title: "Andesite by the stack"
	quest.2B00000000000003.quest_desc: ["Double-smelt Zinc Ingot + Andesite on the Brick Forge into Andesite Alloy (the crafting and mixing routes are gone). Eight to start."]
	quest.2B00000000000003.title: "Andesite Alloy"
	quest.2B00000000000004.quest_desc: ["Cut 16 Shafts from Andesite Alloy."]
	quest.2B00000000000004.title: "Sixteen shafts"
	quest.2B00000000000005.quest_desc: ["Assemble a windmill: one Windmill Bearing (a Hephaestus ritual of Polished Deepslate, 4 Shafts and 2 Deorum Nuggets) and sixteen Windmill Sails."]
	quest.2B00000000000005.title: "The Windmill"
	quest.2B00000000000006.quest_desc: ["A Hephaestus ritual stuffs String with 2 Planks and 6 Wool (20 aureal). Optional - but without them a siren's song will walk you into the sea."]
	quest.2B00000000000006.title: "Earplugs"
	quest.2B00000000000007.quest_desc: ["Hunt sirens off the coast - wearing the Earplugs, if you were sensible - until one yields a Siren Tear."]
	quest.2B00000000000007.title: "A Siren's Tear"
	quest.2B00000000000008.quest_desc: ["A Hephaestus ritual around a Siren Tear: 2 Colossal Iron, 2 Gilded Plate, a Gilded Ingot smithing template, 2 Amethyst and an Emerald (200 aureal / 10000 blood / 10 souls). Right-click it to summon Eldorath."]
	quest.2B00000000000008.title: "Builder Stone"
	quest.2B00000000000009.quest_desc: ["Defeat Eldorath the Ancient Builder, the diamond keeper."]
	quest.2B00000000000009.title: "Slay Eldorath"
	quest.2B0000000000000A.quest_desc: ["Gather 3 Diamonds from the deeps Eldorath guarded."]
	quest.2B0000000000000A.title: "A few diamonds"
	quest.2B0000000000000B.quest_desc: ["Carve a Diamond pickaxe head at the Carving Station."]
	quest.2B0000000000000B.title: "Diamond pickaxe head"
	quest.2B0000000000000C.quest_desc: ["Stockpile 64 Diamonds."]
	quest.2B0000000000000C.title: "A king's ransom"
	quest.2B0000000000000D.quest_desc: ["Carve an Amethyst Slate at the Carving Station - amethyst cuts cleaner than stone and holds an edge far longer."]
	quest.2B0000000000000D.title: "An Amethyst Slate"
	quest.2B0000000000000E.quest_desc: ["Carve the slate into an Amethyst pickaxe head, then socket it into a blueprint. It is the pickaxe that breaks Soulstone Ore - and it swings faster than anything else at its tier."]
	quest.2B0000000000000E.title: "Amethyst pickaxe head"
	quest.2B0000000000000F.quest_desc: ["Take the amethyst pickaxe to Soulstone Ore and bring back four Raw Soulstone."]
	quest.2B0000000000000F.title: "Raw Soulstone"
	quest.2B00000000000010.quest_desc: ["A plain Brick-Forge alloy now: 1 Diamond + 1 Raw Soulstone into Refined Soulstone (the mallet strike, charcoal and furnace routes are all gone)."]
	quest.2B00000000000010.title: "Refined Soulstone"
	quest.2B00000000000011.quest_desc: ["At the Hephaestus Forge, bind Runewood Planks, 4 Refined Soulstone and 4 Gold Plates (500 aureal / 5000 blood / 10 souls / 100 XP) into Malum's Spirit Altar."]
	quest.2B00000000000011.title: "The Spirit Altar"
	quest.2B00000000000012.quest_desc: ["A Hephaestus ritual now makes Brass: a Colossal Iron core with Deorum, 2 Zinc and 2 Rose Gold yields 2 Brass Ingots. The Brick-Forge alloy route is gone."]
	quest.2B00000000000012.title: "Brass Ingot"
	quest.2B00000000000013.quest_desc: ["Apply a Brass Ingot onto a placed Edelwood Log - the log takes the casing."]
	quest.2B00000000000013.title: "Brass Casing"
	quest.2B00000000000014.quest_desc: ["The Spirit Altar now makes Electron Tubes: Natural Quartz infused with Redstone and Slag-cast Gold and Iron Plates, paid in Arcane and Aerial spirits. Bank nine."]
	quest.2B00000000000014.title: "Nine Electron Tubes"
	quest.2B00000000000015.quest_desc: ["Bring down Ashlord, the Infernal Dragon, atop its Dragon Tower."]
	quest.2B00000000000015.title: "Slay the Ashlord"
	quest.2B00000000000016.quest_desc: ["Collect 9 Dragon Bones from the Ashlord."]
	quest.2B00000000000016.title: "Nine Dragon Bones"
	quest.2B00000000000017.quest_desc: ["A Hephaestus ritual now: a Redstone core with 4 Iron Ingots on the pedestals, no essence cost. (The forge-strike recipe is gone and Iron's Spellbooks' 3x3 Wayward Compass recipe is disabled.)"]
	quest.2B00000000000017.title: "Compass"
	quest.2B00000000000018.quest_desc: ["A Hephaestus ritual binds a Compass with 2 Arcane Essence, 4 Runes and 2 Ender Pearls (4 souls / 10 XP). The trapped soul points toward its home - the catacombs."]
	quest.2B00000000000018.title: "Wayward Compass"
	quest.2B00000000000019.quest_desc: ["Follow the Wayward Compass into the catacombs and put the Dead King down. He always yields his Decrepit Scythe."]
	quest.2B00000000000019.title: "The Dead King"
	quest.2B0000000000001A.quest_desc: ["Reforge the Decrepit Scythe at the Hephaestus Forge with Colossal Iron, 3 Iron, 2 Dragon Bones, a Gilded Ingot smithing template and a Lantern (1000 aureal / 1000 blood / 10 souls) into Malum's Crude Scythe."]
	quest.2B0000000000001A.title: "harvest time"
	quest.2B0000000000001B.quest_desc: ["Reap 64 spirits with the scythe beside a Spirit Altar. Any combination of the eight types counts."]
	quest.2B0000000000001B.title: "Among Us"
	quest.2B0000000000001C.quest_desc: ["Every road ends here. The Spirit Altar binds a Brass Casing with a Dragon Bone, an Electron Tube, a Cogwheel and a Diamond (4 Eldritch / 4 Earthen / 4 Arcane) into ONE Crafter. Build nine."]
	quest.2B0000000000001C.title: "Nine Mechanical Crafters"
	quest.2B0000000000001D.quest_desc: ["Now the wall builds itself: a crafter-only recipe of Andesite Alloy, Electron Tube, Shafts, Brass Casing and a Cogwheel. Make sixteen more."]
	quest.2B0000000000001D.title: "Crafters crafting crafters"
	quest.2B0000000000001E.quest_desc: ["A 5x5 crafter wall: an Edelwood Plank ring around Null Slate corners, Cogwheel sides and a Creaking Heart at its centre. The grid, at last."]
	quest.2B0000000000001E.title: "Crafting Crafting Table"
	quest.2B0000000000001F.quest_desc: ["Crafting has to wait for just a little longer."]
	quest.2B0000000000001F.title: "Not So Fast"
	quest.2B00000000000021.quest_desc: ["Hunt two Sea Serpents off the coast."]
	quest.2B00000000000021.title: "Sea Serpents"
	quest.2B00000000000022.quest_desc: ["Bring back 3 Blaze Powder from the Nether."]
	quest.2B00000000000022.title: "Blaze Powder"
	quest.2B00000000000024.quest_desc: ["Forge a Fire-Infused Iron Ingot."]
	quest.2B00000000000024.title: "Fire-Infused Iron"
	quest.2B00000000000025.quest_desc: ["Mine 4 Runes from Runic Stones."]
	quest.2B00000000000025.title: "Mine a Rune"
	quest.2B00000000000026.quest_desc: ["Find me."]
	quest.2B00000000000026.title: "Into the Nether"
	quest.2B00000000000027.quest_desc: ["Craft a Furnace - an iron frame over a cobblestone/netherrack base (crafting table or Mechanical Crafter)."]
	quest.2B00000000000027.title: "Furnace"
	quest.2B00000000000028.quest_desc: ["Craft a Blast Furnace: a Furnace ringed in Fire-Infused Iron over Smooth Stone and a Magma Block."]
	quest.2B00000000000028.title: "Blast Furnace"
	quest.2B00000000000029.quest_desc: ["Spirit-infuse a Brick Forge with Blast Furnaces, Chiseled Polished Darkstone, Runes and Fire Lilies into a Clibano Core."]
	quest.2B00000000000029.title: "The Clibano Core"
	quest.2B0000000000002A.quest_desc: ["Raise the Slag foundry: a Melter, a Fluid Interface, a Casting Table and Basin, two Drains and eight Crucibles."]
	quest.2B0000000000002A.title: "Light The Forge"
	quest.2B0000000000002B.quest_desc: ["Mine 8 Raw Brilliance."]
	quest.2B0000000000002B.title: "Raw Brilliance"
	quest.2B0000000000002C.quest_desc: ["Refine into 4 Refined Brilliance (Brick Forge 2->1; Furnace or Blast 1->1)."]
	quest.2B0000000000002C.title: "Refined Brilliance"
	quest.2B0000000000002D.quest_desc: ["Gather 4 Mnemonic Fragments."]
	quest.2B0000000000002D.title: "Mnemonic Fragments"
	quest.2B0000000000002E.quest_desc: ["Slay a Cyclops for its Eye."]
	quest.2B0000000000002E.title: "The Cyclops"
	quest.2B0000000000002F.quest_desc: ["Spirit-infuse a Cyclops Eye with Mnemonic Fragments, Null Slate, Arcane Ingots, Ender Pearls, a Stymphalian Feather, Andesite Alloy and Soulstained Steel into the Twilight Concord."]
	quest.2B0000000000002F.title: "Twilight Concord"
	quest.2B00000000000030.quest_desc: ["Build the portal - a Liquid Prismarine pool ringed with Fire, Frost and Lightning Lilies - throw in the Twilight Concord and step through into the Twilight Forest."]
	quest.2B00000000000030.title: "Into the Twilight"
	quest.2B00000000000031.quest_desc: ["Defeat the Naga in its courtyard."]
	quest.2B00000000000031.title: "Otherworldly Serpent"
	quest.2B00000000000032.quest_desc: ["Hephaestus-forge the Naga Trophy into a Shield Maiden (2 Firefly Jars, a Precision Mechanism, a Bound Soul Ingot, a Hippocampus Fin, a Fang of the Hound Leader, a Nightmare Claw and a Permafrost Shard). It is your key to the Lich - be sure to dupe it if you have friends :)"]
	quest.2B00000000000032.title: "The Shield Maiden"
	quest.2B00000000000033.quest_desc: ["Carry the Shield Maiden up the Lich Tower and break his three shield phases. His trophy is worth duping at the Spirit Altar - one trophy in, two out."]
	quest.2B00000000000033.title: "The Twilight Lich"
	quest.2B00000000000035.quest_desc: ["Craft a Depot (Andesite Alloy around an Andesite Casing)."]
	quest.2B00000000000035.title: "Depot"
	quest.2B00000000000036.quest_desc: ["Craft a Basin."]
	quest.2B00000000000036.title: "Basin"
	quest.2B00000000000037.quest_desc: ["Craft a Mechanical Press."]
	quest.2B00000000000037.title: "Mechanical Press"
	quest.2B00000000000038.quest_desc: ["Press 8 Iron Sheets."]
	quest.2B00000000000038.title: "Iron Sheet"
	quest.2B00000000000039.quest_desc: ["Craft a Mechanical Mixer."]
	quest.2B00000000000039.title: "Mechanical Mixer"
	quest.2B0000000000003A.quest_desc: ["Craft an Encased Fan."]
	quest.2B0000000000003A.title: "Encased Fan"
	quest.2B0000000000003B.quest_desc: ["Craft a Deployer - a Brass Hand, Andesite Casing, Shaft, Electron Tube and Cogwheel (or the 5x5 crafter version)."]
	quest.2B0000000000003B.title: "The Deployer"
	quest.2B0000000000003C.quest_desc: ["Build fluid handling: a Spout and an Item Drain."]
	quest.2B0000000000003C.title: "Spout and Drain"
	quest.2B0000000000003D.quest_desc: ["Mechanical-craft two Crushing Wheels - an Andesite Alloy ring with Obsidiansteel where the planks were and a Canopy Wood core. You need a facing pair to crush."]
	quest.2B0000000000003D.title: "Crushing Wheels"
	quest.2B0000000000003E.quest_desc: ["Gather a Dark Metal Ingot from the Born in Chaos line."]
	quest.2B0000000000003E.title: "Dark Metal Ingot"
	quest.2B0000000000003F.quest_desc: ["Forge an Empty Blaze Burner: an Iron Sheet shell and Deep Alloy base around a Netherrack core (the 3x3, or the 5x5 crafter version)."]
	quest.2B0000000000003F.title: "Empty Blaze Burner"
	quest.2B00000000000040.quest_desc: ["Light it - capture a Blaze the old way, or spirit-infuse the Empty Burner with 12 Nether Brick, 2 Fire-Infused Iron, a Dark Metal Ingot and a Campfire (16 Wicked / 16 Earthen / 32 Infernal)."]
	quest.2B00000000000040.title: "Blaze Burner"
	quest.2B00000000000041.quest_desc: ["Sequence-assemble a Precision Mechanism: on a Brass Sheet deploy a Cogwheel, a Large Cogwheel and a Lightning-Infused Iron Nugget, looped."]
	quest.2B00000000000041.title: "Precision Mechanism"
	quest.2B00000000000042.quest_desc: ["Mechanical-craft a Mechanical Arm - Brass Casing, a Precision Mechanism, Brass Hands and Shafts (the 3x3 uses brass sheet + brass hand)."]
	quest.2B00000000000042.title: "Mechanical Arm"
	quest.2B00000000000043.quest_desc: ["The first real test of your factory. HINT: automate this - hand-assembling 16 Structural Beams (shaft -> sequenced assembly) is misery. Then chain them into a Large Water Wheel."]
	quest.2B00000000000043.title: "First Real Challenge"
	quest.2B00000000000044.quest_desc: ["The last thing Chapter 2 asks of you. A Tier-1 Hephaestus ritual burns a Crafting Table down into a licence: 1000 Aureal, 10 Souls, 10000 Blood and 900 Ink, around eight pedestals - Exanimate Essence, a Precision Mechanism, a Bound Soul Ingot, a Totemic Gold Ingot, an Electron Tube, a Structural Beam, a Blank Runestone and a Book and Quill. Consume it and the 3x3 grid is yours for good; it survives death and follows you everywhere. Until then every crafting table refuses to open."]
	quest.2B00000000000044.title: "The Crafting License"
	quest.2B00000000000048.quest_desc: ["Hephaestus-forge the Lich Trophy into an Acolyte of Deflection (2 Dragon Bones, 2 Hallowed Gold Ingots, a Shattered Skull, a Precision Mechanism, a Bound Soul Ingot and a Magic Map Focus). Dupe the trophy at the Spirit Altar first if you want to keep one on the wall."]
	quest.2B00000000000048.title: "The Acolyte of Deflection"
	quest.2B00000000000049.quest_desc: ["The bench every slate is cut on, and this chapter opens on it. The stock Water-Bucket 2x2 recipe makes one; once the Forge is up, a Tier-1 ritual binds a Stonecutter with an Amethyst Shard, a Heart of the Sea and 2 Chiseled Deepslate instead."]
	quest.2B00000000000049.title: "The Carving Station"
	quest.2B0000000000004A.quest_desc: ["Brass needs zinc, and the Brick Forge smelts two raw into one ingot."]
	quest.2B0000000000004A.title: "Eight Zinc Ingots"
	quest.2B0000000000004B.quest_desc: ["Any four logs of the Edelwood family. The casing is wrapped in them."]
	quest.2B0000000000004B.title: "Four Edelwood"
	quest.2B0000000000004C.quest_desc: ["The compass points at them. Go and stand in one."]
	quest.2B0000000000004C.title: "Find the Catacombs"
	quest.2B0000000000004D.quest_desc: ["If you struggle to find dead dragons, you can spare some of ashlord bones."]
	quest.2B0000000000004D.title: "Two Dragon Bones"
	quest.2B0000000000004E.quest_desc: ["Sixty-four. Everything Create asks for starts here."]
	quest.2B0000000000004E.title: "Andesite Alloy stockpile"
	quest.2B0000000000004F.quest_desc: ["Sixty-four Brass Ingots."]
	quest.2B0000000000004F.title: "Brass stockpile"
	quest.2B00000000000050.quest_desc: ["Sixty-four. Malum spends it by the stack."]
	quest.2B00000000000050.title: "Refined Soulstone stockpile"
	quest.2B00000000000051.quest_desc: ["Sixty-four Zinc Ingots."]
	quest.2B00000000000051.title: "Zinc stockpile"
	quest.2B00000000000052.quest_desc: ["Eight Arcane Essence. It falls out of magic-touched mobs and turns up in almost any chest worth opening - and nothing in Iron's Spellbooks binds without it."]
	quest.2B00000000000052.title: "Arcane Essence"
	quest.2B00000000000053.quest_desc: ["One Emerald. The Builder Stone will not bind without it - trade a villager down or go and dig."]
	quest.2B00000000000053.title: "An Emerald"
	quest.2B00000000000054.quest_desc: ["One Lantern. The scythe is reforged around a light."]
	quest.2B00000000000054.title: "A Lantern"
	quest.2B00000000000055.quest_desc: ["Magitech's crucible - three iron and a tourmaline around the rim. Everything Zardius alchemy asks for goes through it."]
	quest.2B00000000000055.title: "The Zardius Crucible"
	quest.2B00000000000056.quest_desc: ["Find me."]
	quest.2B00000000000056.title: "Magma Blocks"
	quest.2B00000000000057.quest_desc: ["Press 8 Golden Sheets."]
	quest.2B00000000000057.title: "Golden Sheet"
	quest.2B00000000000058.quest_desc: ["Press 8 Copper Sheets."]
	quest.2B00000000000058.title: "Copper Sheet"
	quest.2B00000000000059.quest_desc: ["Press 8 Brass Sheets."]
	quest.2B00000000000059.title: "Brass Sheet"
	quest.2B0000000000005A.quest_desc: ["Craft a Mechanical Saw - an Andesite Casing, a Propeller, a Shaft and an Iron Sheet."]
	quest.2B0000000000005A.title: "Mechanical Saw"
	quest.2B0000000000005B.quest_desc: ["Mix over heat: an Ender Pearl, 4 Prismarine Shards and 6 Refined Brilliance."]
	quest.2B0000000000005B.title: "Weeping Eye"
	quest.2B0000000000005C.quest_desc: ["Craft a pair of Engineer's Goggles - they read stress and speed off a shaft."]
	quest.2B0000000000005C.title: "Engineer's Goggles"
	quest.2B0000000000005D.quest_desc: ["Craft a Wrench. Rotates a placed block, or picks it back up."]
	quest.2B0000000000005D.title: "Wrench"
	quest.2B0000000000005E.quest_desc: ["Craft a Rotational Speed Controller - set any shaft to the rpm you want."]
	quest.2B0000000000005E.title: "Rotational Speed Controller"
	quest.2B0000000000005F.quest_desc: ["Craft a Fluid Tank - Copper Sheets around Glass."]
	quest.2B0000000000005F.title: "Fluid Tank"
	quest.2B00000000000060.quest_desc: ["You will need a lot of them. It's a good idea to start production sooner."]
	quest.2B00000000000060.title: "Bound Soul Ingot"
	quest.2C00000000000001.quest_desc: ["Every tablet you find is written in a language nobody speaks. This is where you break it."]
	quest.2C00000000000001.title: "The Spelunkery Table"
	quest.2C00000000000002.quest_desc: ["Translate it at the Spelunkery Table, then follow the map it earns you."]
	quest.2C00000000000002.title: "A Magnetic Tablet"
	quest.2C00000000000003.title: "The Magnetic Caves"
	quest.2C00000000000004.title: "Azure Magnet"
	quest.2C00000000000005.title: "Scarlet Magnet"
	quest.2C00000000000006.title: "Azure Neodymium Ingot"
	quest.2C00000000000007.title: "Scarlet Neodymium Ingot"
	quest.2C00000000000008.title: "Energized Galena"
	quest.2C00000000000009.title: "Azure Energized Galena"
	quest.2C0000000000000A.title: "Scarlet Energized Galena"
	quest.2C0000000000000B.title: "Ferrouslimeball"
	quest.2C0000000000000C.title: "Heart of Iron"
	quest.2C0000000000000D.title: "Heavyweight"
	quest.2C0000000000000E.title: "Notor Gizmo"
	quest.2C0000000000000F.title: "Telecore"
	quest.2C00000000000010.title: "Tesla Bulb"
	quest.2C00000000000011.title: "Depth Charge"
	quest.2C00000000000012.quest_desc: ["Translate it at the Spelunkery Table, then follow the map it earns you."]
	quest.2C00000000000012.title: "A Primordial Tablet"
	quest.2C00000000000013.title: "The Primordial Caves"
	quest.2C00000000000014.title: "Amber Curiosity"
	quest.2C00000000000015.title: "Heavy Bone"
	quest.2C00000000000016.title: "Tough Hide"
	quest.2C00000000000017.title: "Tectonic Shard"
	quest.2C00000000000018.title: "Pewen Sap"
	quest.2C00000000000019.title: "Tree Star"
	quest.2C0000000000001A.quest_desc: ["Translate it at the Spelunkery Table, then follow the map it earns you."]
	quest.2C0000000000001A.title: "A Toxic Tablet"
	quest.2C0000000000001B.title: "The Toxic Caves"
	quest.2C0000000000001C.title: "Uranium"
	quest.2C0000000000001D.title: "Uranium Rod"
	quest.2C0000000000001E.title: "Sulfur Dust"
	quest.2C0000000000001F.title: "Toxic Paste"
	quest.2C00000000000020.title: "Polymer Plate"
	quest.2C00000000000021.title: "Fissile Core"
	quest.2C00000000000022.title: "Charred Remnant"
	quest.2C00000000000023.title: "Bottle of Radon"
	quest.2C00000000000024.title: "Cinder Brick"
	quest.2C00000000000025.title: "Waste Drum"
	quest.2C00000000000026.quest_desc: ["Translate it at the Spelunkery Table, then follow the map it earns you."]
	quest.2C00000000000026.title: "An Abyssal Tablet"
	quest.2C00000000000027.title: "The Abyssal Chasm"
	quest.2C00000000000028.title: "Mussel"
	quest.2C00000000000029.title: "Sea Glass Shards"
	quest.2C0000000000002A.title: "Marine Snow"
	quest.2C0000000000002B.title: "Bioluminesscence"
	quest.2C0000000000002C.title: "Magic Conch"
	quest.2C0000000000002D.title: "Gazing Pearl"
	quest.2C0000000000002E.title: "Immortal Embryo"
	quest.2C0000000000002F.quest_desc: ["Translate it at the Spelunkery Table, then follow the map it earns you."]
	quest.2C0000000000002F.title: "A Forlorn Tablet"
	quest.2C00000000000030.title: "The Forlorn Hollows"
	quest.2C00000000000031.title: "Thornwood Branch"
	quest.2C00000000000032.title: "Guano"
	quest.2C00000000000033.title: "Moth Dust"
	quest.2C00000000000034.title: "Vesper Wing"
	quest.2C00000000000035.title: "Corrodent Teeth"
	quest.2C00000000000036.title: "Dark Tatters"
	quest.2C00000000000037.title: "Shadow Silk"
	quest.2C00000000000038.title: "Occult Gem"
	quest.2C00000000000039.title: "Pure Darkness"
	quest.3B0000000000000B.quest_desc: ["Claim the Deep Waters Key and open the way below."]
	quest.3B0000000000000B.title: "Deep Waters Key"
	quest.3B0000000000000C.quest_desc: ["Cut Aquamarine out of the Deep Waters stone."]
	quest.3B0000000000000C.title: "Mine Aquamarine"
	quest.3B0000000000000D.quest_desc: ["Sixteen Flaming Opal. The shrine drinks a lot of it."]
	quest.3B0000000000000D.title: "Mine Flaming Opal"
	quest.3B0000000000000E.quest_desc: ["Find a Pearl in the deep."]
	quest.3B0000000000000E.title: "Get a Pearl"
	quest.3B0000000000000F.quest_desc: ["Raise the shrine around a Conduit, down in the Deep Waters and nowhere else: a mossy floor and roof, a Flaming Opal Pillar above and below the Conduit, four diagonal posts, and aquamarine crystals ringing the base and crowning the top. Then use a Crowned Jelly on the Conduit. If it has room - water below, six blocks out, and a clear column overhead - the whole thing floods and a Stormcall Altar rises where the Conduit stood."]
	quest.3B0000000000000F.title: "Build the Shrine"
	quest.3B00000000000010.quest_desc: ["Hunt the Kraken in the open ocean."]
	quest.3B00000000000010.title: "Nerakyss, The Kraken"
	quest.3B00000000000011.quest_desc: ["Take the Abyss Eye from the drowned depths."]
	quest.3B00000000000011.title: "Eye of the Abyss"
	quest.3B00000000000012.quest_desc: ["Find a Desert Pyramid and go inside - mind the pressure plate. Its treasure holds a map, and the map leads to the Gorgon."]
	quest.3B00000000000012.title: "The Desert Pyramid"
	quest.3B00000000000013.quest_desc: ["Bring down Sirok where the sand runs deep."]
	quest.3B00000000000013.title: "Sirok, The Sandworm"
	quest.3B00000000000014.quest_desc: ["Take the Desert Eye from the dunes."]
	quest.3B00000000000014.title: "Eye of the Desert"
	quest.3B00000000000015.quest_desc: ["Climb to the Yeti Lair and put the Alpha down."]
	quest.3B00000000000015.title: "The Alpha Yeti"
	quest.3B00000000000016.quest_desc: ["Take the Aurora Palace and end the Snow Queen."]
	quest.3B00000000000016.title: "The Snow Queen"
	quest.3B00000000000017.quest_desc: ["A second yeti, and a worse one. Kill Skor."]
	quest.3B00000000000017.title: "Skor, The Yeti"
	quest.3B00000000000018.quest_desc: ["Take the Cursed Eye from the ice."]
	quest.3B00000000000018.title: "Eye of the Curse"
	quest.3B00000000000019.quest_desc: ["Take the Storm Eye out of the sky."]
	quest.3B00000000000019.title: "Eye of the Storm"
	quest.3B0000000000001A.quest_desc: ["Follow the pyramid's map to the Gorgon Temple and kill what lives in it. Do not look at her."]
	quest.3B0000000000001A.title: "The Gorgon"
	quest.3B0000000000001B.quest_desc: ["Take the Goblin Knight Stronghold and put the Knight Phantoms down - they fight in numbers."]
	quest.3B0000000000001B.title: "The Knight Phantoms"
	quest.3B0000000000001C.quest_desc: ["Climb the Dark Tower and bring down the Ur-Ghast."]
	quest.3B0000000000001C.title: "The Ur-Ghast"
	quest.3B0000000000001D.quest_desc: ["Gather the whole shrine before you start placing it, because it only counts when the last block lands: 130 Mossy Stone Bricks for the floor and roof, the aquamarine crystals that ring and crown it, two Flaming Opal Pillars, and the Conduit at its heart."]
	quest.3B0000000000001D.title: "The Shrine in pieces"
	quest.3B0000000000001E.quest_desc: ["The shrine is lit and the deep has noticed. Hunt down the Man O' War."]
	quest.3B0000000000001E.title: "Man O' War"
	quest.3B0000000000001F.quest_desc: ["Take the Gorgon's head to the bench and read the sand with it: two Death Worm Chitin above and below, Glow Ink Sacs either side of an Empty Map, Rare Ink beneath. The head is only the lens - it stays in the grid. Craft it as a player and the chart reads itself; let a machine craft it and you must right-click it yourself."]
	quest.3B0000000000001F.title: "Sirok's Nest Map"
	quest.3B00000000000020.quest_desc: ["Sea Serpent Scales around an Empty Map, Glow Ink either side, Rare Ink beneath - and a Black Pearl at the top, which the chart only reads and does not spend. It charts the Kraken's ship."]
	quest.3B00000000000020.title: "The Kraken's Ship"
	quest.3B00000000000021.quest_desc: ["The Snow Queen's Trophy reads the ice for you - it stays in the grid. Ring it with Alpha Yeti Fur around an Empty Map, Glow Ink and Rare Ink, and the chart finds the hideout."]
	quest.3B00000000000021.title: "Skor's Hideout"
	quest.3B00000000000022.quest_desc: ["Take a Coral Chunk out of the drowned deep."]
	quest.3B00000000000022.title: "Coral Chunk"
	quest.3B00000000000023.quest_desc: ["The dunes pay in two currencies: Ancient Metal and the bones of the Koboletons."]
	quest.3B00000000000023.title: "Bone and Ancient Metal"
	quest.3B00000000000024.quest_desc: ["Two metals come off the ice: Cursium and Black Steel."]
	quest.3B00000000000024.title: "Cursium and Black Steel"
	quest.3B00000000000025.quest_desc: ["The sky leaves two things behind: Lacrima, and the Essence of the Storm."]
	quest.3B00000000000025.title: "Lacrima and Storm"
	quest.3B00000000000026.quest_desc: ["A 7x7 crafter wall: Astral Weave at the corners, Soul-Stained Steel Plating through the frame, Flaming Opal and Blocks of Aquamarine inside it, Diamond Blocks and Coral Chunks around a Black Pearl at the centre."]
	quest.3B00000000000026.title: "The Abyssal Core"
	quest.3B00000000000027.quest_desc: ["A 7x7 crafter wall: Brass Sheet edge, Gilded Plate at the four mid-points, Cthonic Gold and Blocks of Rose Gold woven with bone - Koboleton or Dragon, either will do - around a Block of Ancient Metal."]
	quest.3B00000000000027.title: "The Desert Core"
	quest.3B00000000000028.quest_desc: ["A 7x7 crafter wall: Blocks of Deep Alloy at the corners, Imitation Flesh through the frame, Cursed Sapballs and Black Steel closing on a Cursium Ingot."]
	quest.3B00000000000028.title: "The Cursed Core"
	quest.3B00000000000029.quest_desc: ["A 7x7 crafter wall: Bottles o' Lightning and Lacrima along the edge, Lapis, Wind Nuclei, Lightning-Infused Iron and the Essence of the Storm around a Heart of the Sea."]
	quest.3B00000000000029.title: "The Storm Core"
	quest.3B0000000000002A.quest_desc: ["Four cores, four elements, one upgrade. A Carved Edelwood Log at the heart, the Abyssal, Desert, Cursed and Storm Cores on the pedestals with 4 Arcane Crystal - and every essence the Tier I forge can hold: 1000 Aureal, 10 Souls, 10000 Blood and 900 Ink. It drains the forge dry and comes back a tier higher."]
	quest.3B0000000000002A.title: "Hephaestus Forge II"
	quest.3B0000000000002B.quest_desc: ["Find a Fire Dragon and bring it down. Older is better - the drops scale with the dragon's size."]
	quest.3B0000000000002B.title: "Dragon Hunt"
	quest.3B0000000000002C.quest_desc: ["Four Fire Dragon Scales - red, green, bronze or gray, any mix. Colour follows the dragon you killed."]
	quest.3B0000000000002C.title: "Gather Scales"
	quest.3B0000000000002D.quest_desc: ["Two Fire Dragon Blood."]
	quest.3B0000000000002D.title: "Gather Blood"
	quest.3B0000000000002E.quest_desc: ["Take the Fire Dragon Heart."]
	quest.3B0000000000002E.title: "The Dragon's Heart"
	quest.3B0000000000002F.quest_desc: ["A Tier-II ritual boils a Bowl down with the Fire Dragon Heart, a Koboleton Bone, Living Flesh, Fire Dragon Blood, two Fire Dragon Scales and a Bucket of Lava - for the full 50 Souls and 15000 Blood the forge can hold. Eat it and the floor turns to lava under you; survive four hits of it - 35 ticks - and the fire stops mattering for a minute."]
	quest.3B0000000000002F.title: "Netherly Meal"
	quest.3B00000000000033.quest_desc: ["Fourteen Obsidian - ten for the frame, and four spare for the ones you will lose."]
	quest.3B00000000000033.title: "Fourteen Obsidian"
	quest.3B00000000000034.quest_desc: ["One Iron Ingot and one Flint. Nothing lights the frame without it."]
	quest.3B00000000000034.title: "Flint and Steel"
	quest.3B00000000000036.quest_desc: ["Cut the flesh off the carcass. Rotten enough on its own; the infusion is what makes it worth carrying."]
	quest.3B00000000000036.title: "Dragon Flesh"
	quest.3B00000000000037.quest_desc: ["Spirit-infuse the Dragon Flesh with 64 Rotten Flesh, 16 Blood Vials and 4 Monster Flesh over Sacred, Wicked and Aqueous spirits. The Netherly Meal needs it."]
	quest.3B00000000000037.title: "Living Flesh"
	quest.3B00000000000049.quest_desc: ["Find the Minotaur's Labyrinth under the Twilight Forest and get inside."]
	quest.3B00000000000049.title: "The Labyrinth"
	quest.3B0000000000004A.quest_desc: ["The Labyrinth's own dish. The Netherly Meal is boiled down from it."]
	quest.3B0000000000004A.title: "Meef Stroganoff"
	quest.3B0000000000004B.quest_desc: ["Strike the frame and watch it catch. Stand and look at the lit portal for a moment - whatever is on the other side is looking back."]
	quest.3B0000000000004B.title: "The Nether?"
	quest.3B0000000000004C.quest_desc: ["Two Ancient Knowledge Fragments."]
	quest.3B0000000000004C.title: "Ancient Knowledge Fragment"
	quest.3B0000000000004D.quest_desc: ["Silk-touch a Sculk Shrieker out of the deep dark."]
	quest.3B0000000000004D.title: "Sculk Shrieker"
	quest.3B0000000000004E.quest_desc: ["Find a shipwreck. The treasure map inside points at the rest."]
	quest.3B0000000000004E.title: "Locate a Shipwreck"
	quest.3B0000000000004F.quest_desc: ["Dig up the buried treasure the map marks."]
	quest.3B0000000000004F.title: "Heart of the Sea"
	quest.3B00000000000050.quest_desc: ["Craft a Conduit - a Heart of the Sea inside eight Nautilus Shells."]
	quest.3B00000000000050.title: "Conduit"
	quest.3B00000000000051.quest_desc: ["Mixed, not crafted: two copper dusts, lapis, and a quartz of either kind."]
	quest.3B00000000000051.title: "Cognitive Flux"
	quest.3B00000000000052.quest_desc: ["Smelt the flux."]
	quest.3B00000000000052.title: "Cognitive Amalgam"
	quest.3B00000000000053.title: "Cognitive Alloy"
	quest.3B00000000000054.title: "Cognitive Crystal"
	quest.3B00000000000055.quest_desc: ["Three alloys onto a crystal, a splash of Timeless Slurry, and a press."]
	quest.3B00000000000055.title: "The Astute Assembly"
	quest.4B00000000000001.quest_desc: ["Placeholder root - this chapter has no content yet."]
	quest.4B00000000000001.title: "Echo and Below"
	quest.4B00000000000002.quest_desc: ["Reach the Otherside."]
	quest.4B00000000000002.title: "The Otherside"
	quest.4B00000000000003.quest_desc: ["Reach Imbrifer, the Deeper Down."]
	quest.4B00000000000003.title: "Deeper Down"
	quest.5B00000000000001.quest_desc: ["Placeholder root - this chapter has no content yet."]
	quest.5B00000000000001.title: "Concordance"
	quest.5B00000000000002.quest_desc: ["Find the Nether Eye."]
	quest.5B00000000000002.title: "Nether Eye"
	quest.5B00000000000003.quest_desc: ["Find the Cold Eye."]
	quest.5B00000000000003.title: "Cold Eye"
	quest.5B00000000000004.quest_desc: ["Find the Old Eye."]
	quest.5B00000000000004.title: "Old Eye"
	quest.5B00000000000005.quest_desc: ["Find the Wither Eye."]
	quest.5B00000000000005.title: "Wither Eye"
	quest.5B00000000000006.quest_desc: ["Find the Rogue Eye."]
	quest.5B00000000000006.title: "Rogue Eye"
	quest.5B00000000000007.quest_desc: ["Find the Magical Eye."]
	quest.5B00000000000007.title: "Magical Eye"
	quest.5B00000000000008.quest_desc: ["Find the Black Eye."]
	quest.5B00000000000008.title: "Black Eye"
	quest.5B00000000000009.quest_desc: ["Find the Lost Eye."]
	quest.5B00000000000009.title: "Lost Eye"
	quest.5B0000000000000A.quest_desc: ["Find the Guardian Eye."]
	quest.5B0000000000000A.title: "Guardian Eye"
	quest.5B0000000000000B.quest_desc: ["Find the Cursed Eye."]
	quest.5B0000000000000B.title: "Cursed Eye"
	quest.5B0000000000000C.quest_desc: ["Find the Undead Eye."]
	quest.5B0000000000000C.title: "Undead Eye"
	quest.5B0000000000000D.quest_desc: ["Find the Corrupted Eye."]
	quest.5B0000000000000D.title: "Corrupted Eye"
	quest.5B0000000000000E.quest_desc: ["Find the Exotic Eye."]
	quest.5B0000000000000E.title: "Exotic Eye"
	quest.5B0000000000000F.quest_desc: ["Find the Witch Eye."]
	quest.5B0000000000000F.title: "Witch Eye"
	quest.5B00000000000010.quest_desc: ["Find the Cryptic Eye."]
	quest.5B00000000000010.title: "Cryptic Eye"
	quest.5B00000000000011.quest_desc: ["Find the Evil Eye."]
	quest.5B00000000000011.title: "Evil Eye"
	quest.6B00000000000001.quest_desc: ["Light the frame and step through. The Netherly Meal is what lets you survive the other side."]
	quest.6B00000000000001.title: "Enter the Nether"
	quest.6B00000000000002.quest_desc: ["Loot the Eye of Monstrous and let it point you at the Ruined Citadel."]
	quest.6B00000000000002.title: "Eye of Monstrous"
	quest.6B00000000000003.quest_desc: ["Wake the thing sleeping in the Citadel and put it back down."]
	quest.6B00000000000003.title: "The Netherite Monstrosity"
	quest.6B00000000000004.quest_desc: ["The Eye of Flame reads the Nether for the Burning Arena."]
	quest.6B00000000000004.title: "Eye of Flame"
	quest.6B00000000000005.quest_desc: ["Ignis does not turn up on his own - the Ashes are the summons."]
	quest.6B00000000000005.title: "Burning Ashes"
	quest.6B00000000000006.quest_desc: ["Burn the Ashes in the Arena and kill what walks out. Ignited Berserkers start appearing in the fortresses afterwards."]
	quest.6B00000000000006.title: "Ignis"
	quest.6B00000000000007.quest_desc: ["Find the Underworld Arena. The door stays shut for now."]
	quest.6B00000000000007.title: "The Underworld Arena"
	quest.6B00000000000008.quest_desc: ["The Arena Door only opens for its own key."]
	quest.6B00000000000008.title: "Underworld Arena Key"
	quest.6B00000000000009.quest_desc: ["Open the door, and finish what is behind it."]
	quest.6B00000000000009.title: "Helvar, the Underworld Knight"
	quest.6B0000000000000A.quest_desc: ["Any of the three starter Pigment Pedestals - Topaz, Amethyst or Citrine. The Onyx and Moonstone upgrades do not count."]
	quest.6B0000000000000A.title: "A Pigment Pedestal"
	quest.6B0000000000000B.quest_desc: ["A Tier-I ritual on the Totemic Staff with two each of Amethyst, Citrine and Topaz Shards, for 500 Ink. Nothing in the Pedestal runs without it."]
	quest.6B0000000000000B.title: "The Paintbrush"
	quest.6B0000000000000C.quest_desc: ["Get inside a Nether Fortress."]
	quest.6B0000000000000C.title: "Into the Fortress"
	quest.6B0000000000000D.quest_desc: ["Wither Skeletons drop them rarely. You need three."]
	quest.6B0000000000000D.title: "Three Wither Skulls"
	quest.6B0000000000000E.quest_desc: ["Four Soul Sand and the three skulls. Build it somewhere you do not mind losing."]
	quest.6B0000000000000E.title: "The Wither"
	quest.6B0000000000000F.quest_desc: ["What the Wither leaves behind."]
	quest.6B0000000000000F.title: "The Nether Star"
	quest.6B00000000000010.quest_desc: ["The Eye of Mech reads the Nether for the Ancient Factory."]
	quest.6B00000000000010.title: "Eye of Mech"
	quest.6B00000000000011.quest_desc: ["Follow the eye and get inside."]
	quest.6B00000000000011.title: "The Ancient Factory"
	quest.6B00000000000012.quest_desc: ["The last thing in the factory. It drops Witherite."]
	quest.6B00000000000012.title: "The Harbinger"
	quest.6B00000000000013.quest_desc: ["Thirty-two each of Amethyst, Topaz and Citrine Shards. The pedestal runs on them."]
	quest.6B00000000000013.title: "Three Kinds of Shard"
	quest.6B00000000000014.quest_desc: ["Shimmerstone Gems glow in the dark rock. The pigment work runs on them."]
	quest.6B00000000000014.title: "Shimmerstone"
	quest.6B00000000000015.quest_desc: ["An Ominous Bottle between two Rotting Essences on a Pigment Pedestal."]
	quest.6B00000000000015.title: "Bottle of Fading"
	quest.6B00000000000016.quest_desc: ["Sixteen Vegetal. Growth given a shape."]
	quest.6B00000000000016.title: "Sixteen Vegetal"
	quest.6B00000000000017.quest_desc: ["Nether Wart grows on soul sand in the fortress stairwells."]
	quest.6B00000000000017.title: "Nether Wart"
	quest.6B00000000000018.quest_desc: ["A Spider Eye ringed with Nether Wart, Sugar and Mushrooms - or churn one in a Mixer."]
	quest.6B00000000000018.title: "Fermented Spider Eye"
	quest.6B00000000000039.quest_desc: ["Build a Fusion Shrine. It works under the open sky, and it watches the moon."]
	quest.6B00000000000039.title: "The Fusion Shrine"
	quest.6B0000000000003A.quest_desc: ["Fuse one at midnight on a new moon, in Molten Netherite."]
	quest.6B0000000000003A.title: "Onyx Shard"
	quest.6B0000000000003B.quest_desc: ["Cyan, magenta and yellow at once. Three pedestals folded into one."]
	quest.6B0000000000003B.title: "The CMY Pedestal"
	quest.6B0000000000003C.quest_desc: ["Black joins the other three."]
	quest.6B0000000000003C.title: "The Onyx Pedestal"
	quest.6B0000000000003D.quest_desc: ["Fading was the first experiment. This one is hungrier."]
	quest.6B0000000000003D.title: "Bottle of Failing"
	quest.6B0000000000003E.quest_desc: ["No pedestal will make this. Brew it in the Potion Workshop."]
	quest.6B0000000000003E.title: "Neolith"
	quest.6B0000000000003F.quest_desc: ["The Fusion Shrine will pull one out of molten gold, rosest gold and scrap."]
	quest.6B0000000000003F.title: "Netherite Ingot"
	quest.6B00000000000040.quest_desc: ["Vegetal will grow into any of the sixteen colours."]
	quest.6B00000000000040.title: "Any Coloured Sapling"
	quest.6B00000000000041.quest_desc: ["Every colour has a pigment of its own, and you will want all of them before long."]
	quest.6B00000000000041.title: "Any Pigment"
	quest.6B00000000000042.quest_desc: ["One pigment, bottled - and it holds a great deal more than the dust it was made from."]
	quest.6B00000000000042.title: "Ink Flask"
	quest.6B00000000000043.quest_desc: ["Every flask in one case."]
	quest.6B00000000000043.title: "Ink Assortment"
	quest.6B00000000000044.quest_desc: ["Carry your ink with you. The Fusion Shrine makes it, in liquid crystal."]
	quest.6B00000000000044.title: "The Pigment Palette"
	quest.6B00000000000045.quest_desc: ["Find it. Something is still awake in there."]
	quest.6B00000000000045.title: "The Lost Citadel"
	quest.6B00000000000046.quest_desc: ["The soulcaller wants five of these, so do not stop at one."]
	quest.6B00000000000046.title: "Cinder Essence"
	quest.6B00000000000047.quest_desc: ["A bell wrapped in ash. Ring it and something answers."]
	quest.6B00000000000047.title: "The Cinderous Soulcaller"
	quest.6B00000000000048.quest_desc: ["The First Flamebearer. Bring the soulcaller, and bring help."]
	quest.6B00000000000048.title: "Echo of Tyros"
	quest.6B0000000000004A.quest_desc: ["Ignitium, stratine and black steel around a doubly compressed table. Everything past here is built on it."]
	quest.6B0000000000004A.title: "The Nether Crafting Table"
	quest.6B0000000000004B.quest_desc: ["Four soulstained steel around a netherite ingot, on the Spirit Altar."]
	quest.6B0000000000004B.title: "Malignant Pewter Ingot"
	quest.6B0000000000004C.quest_desc: ["Inert until the amethyst gets at it."]
	quest.6B0000000000004C.title: "The Null Blaze Cube"
	quest.6B0000000000004D.quest_desc: ["Bless the null cube on the Altar of Amethyst."]
	quest.6B0000000000004D.title: "The Blaze Cube"
	quest.6B0000000000004E.quest_desc: ["The shell every Mekanism machine is built in."]
	quest.6B0000000000004E.title: "Steel Casing"
	quest.6B0000000000004F.title: "Corrupti Dust"
	quest.6B00000000000050.title: "Dark Matter"
	quest.6B00000000000051.quest_desc: ["Throw Corrupti Dust and Dark Matter down together and stand well back. It leaves no drop - looking at it is the whole quest."]
	quest.6B00000000000051.title: "Witness a Black Hole"
	quest.7B00000000000001.quest_desc: ["Shaped in your 2x2: a Copper Ingot and Leather over String and Paper. Your first spell journal - this replaces the old nine-slot recipe."]
	quest.7B00000000000001.title: "Flimsy Journal"
	quest.7B00000000000002.quest_desc: ["In your 2x2: a Book and Quill top right over two Planks (replaces the stock recipe). The table that writes spells into books."]
	quest.7B00000000000002.title: "Inscription Table"
	quest.7B00000000000003.quest_desc: ["Craft the Scroll Forge - where spell scrolls are inscribed."]
	quest.7B00000000000003.title: "Scroll Forge"
	quest.7B00000000000004.quest_desc: ["Craft the Alchemist Cauldron - brew inks and reagents."]
	quest.7B00000000000004.title: "Alchemist Cauldron"
	quest.7B00000000000005.quest_desc: ["Craft the Arcane Anvil - upgrade and repair spell gear."]
	quest.7B00000000000005.title: "Arcane Anvil"
	quest.7B00000000000006.quest_desc: ["Obtain the Ironbound Tome."]
	quest.7B00000000000006.title: "Book of Steel"
	quest.7B00000000000007.quest_desc: ["Obtain the Rotten Spell Book."]
	quest.7B00000000000007.title: "Rotten Spell Book"
	quest.7B00000000000008.quest_desc: ["Obtain the Apprentice's Spell Book."]
	quest.7B00000000000008.title: "Apprentice's Spell Book"
	quest.7B00000000000009.quest_desc: ["Obtain the Enchanted Spell Book."]
	quest.7B00000000000009.title: "Enchanted Spell Book"
	quest.7B0000000000000A.quest_desc: ["Obtain the Necronomicon."]
	quest.7B0000000000000A.title: "Necronomicon"
	quest.7B0000000000000B.quest_desc: ["Obtain the Blaze Instruction Manual."]
	quest.7B0000000000000B.title: "Blaze Instruction Manual"
	quest.7B0000000000000C.quest_desc: ["Obtain the Frostbranded Book."]
	quest.7B0000000000000C.title: "Frostbranded Book"
	quest.7B0000000000000D.quest_desc: ["Obtain the Druidic Tome."]
	quest.7B0000000000000D.title: "Druidic Tome"
	quest.7B0000000000000E.quest_desc: ["Obtain the Villager Bible."]
	quest.7B0000000000000E.title: "Villager Bible"
	quest.7B0000000000000F.quest_desc: ["Obtain the Dragonskin Spell Book."]
	quest.7B0000000000000F.title: "Dragonskin Spell Book"
	quest.7B00000000000010.quest_desc: ["Obtain the Grimoire of Evokation."]
	quest.7B00000000000010.title: "Grimoire of Evokation"
	quest.7B00000000000011.quest_desc: ["Obtain the Vampiric Spell Book."]
	quest.7B00000000000011.title: "Vampiric Spell Book"
	quest.7B00000000000012.quest_desc: ["Obtain the Ignis Spellbook."]
	quest.7B00000000000012.title: "Ignis Spellbook"
	quest.7B00000000000013.quest_desc: ["Obtain the Codex of Malice."]
	quest.7B00000000000013.title: "Codex of Malice"
	quest.7B00000000000014.quest_desc: ["Obtain the Desert Spellbook."]
	quest.7B00000000000014.title: "Desert Spellbook"
	quest.7B00000000000015.quest_desc: ["Obtain the Book o' R'lyeh."]
	quest.7B00000000000015.title: "Book o' R'lyeh"
	quest.7B00000000000016.quest_desc: ["Obtain the Black Book."]
	quest.7B00000000000016.title: "Black Book"
	quest.7B00000000000017.quest_desc: ["Obtain the Volume of the Deep."]
	quest.7B00000000000017.title: "Volume of the Deep"
	quest.7B00000000000018.quest_desc: ["Obtain The Apocrypha."]
	quest.7B00000000000018.title: "The Apocrypha"
	quest.7B00000000000019.quest_desc: ["Obtain the Ancient Codex."]
	quest.7B00000000000019.title: "Ancient Codex"
	quest.7B0000000000001A.quest_desc: ["Obtain the Dragonmancer's Oathbook."]
	quest.7B0000000000001A.title: "Dragonmancer's Oathbook"
	quest.7B0000000000001B.quest_desc: ["Obtain the Grimoire of Color, vol.I."]
	quest.7B0000000000001B.title: "Grimoire of Color, vol.I"
	quest.7B0000000000001C.quest_desc: ["WIP"]
	quest.7B0000000000001C.title: "one above all"
	quest.7B0000000000001D.quest_desc: ["The Smithing Table heads the armoury below: every suit of armour in the pack, grouped by mod (a demo showcase, unlinked)."]
	quest.7B0000000000001D.title: "Smithing Table"
	quest.7B0000000000001E.quest_desc: ["The Carving Station heads the arsenal below: every weapon in the pack, grouped by mod (a demo showcase, unlinked)."]
	quest.7B0000000000001E.title: "Carving Station"
	quest.7B0000000000001F.quest_desc: ["Each Hazmat piece cuts radiation damage 25%; full set (with the Hazmat Mask) grants radiation immunity."]
	quest.7B0000000000001F.title: "Hazmat Set"
	quest.7B00000000000020.quest_desc: ["While worn: eating raw meat restores extra hunger and saturation (more with additional Primordial pieces)."]
	quest.7B00000000000020.title: "Primordial Set"
	quest.7B00000000000021.quest_desc: ["While worn: grants Water Breathing and increased swim speed."]
	quest.7B00000000000021.title: "Diving Set"
	quest.7B00000000000024.quest_desc: ["While worn: delays imminent death, postponing an otherwise-fatal blow."]
	quest.7B00000000000024.title: "Howling Set"
	quest.7B00000000000025.quest_desc: ["Full set: Speed II, Jump Boost II, +3 block reach."]
	quest.7B00000000000025.title: "Apprentice Builder Armor Set"
	quest.7B00000000000026.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B00000000000026.title: "Arion Helmet Set"
	quest.7B00000000000027.quest_desc: ["Full set: killing a mob heals 1 heart; immune to Hemorrhage."]
	quest.7B00000000000027.title: "Bloody Armor Set"
	quest.7B00000000000028.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B00000000000028.title: "Calamitous Armor Set"
	quest.7B00000000000029.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B00000000000029.title: "Elvenite Armor Set"
	quest.7B0000000000002A.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B0000000000002A.title: "Elvenite Halo Set"
	quest.7B0000000000002B.quest_desc: ["Full set: Speed III, Jump Boost II, +4 block reach."]
	quest.7B0000000000002B.title: "Expert Builder Armor Set"
	quest.7B0000000000002C.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B0000000000002C.title: "Gilded Armor Set"
	quest.7B0000000000002D.quest_desc: ["Full set: when hit, per-piece chance to spawn a retaliating Sunbeam (helmet 5%, other pieces 10%)."]
	quest.7B0000000000002D.title: "Helionite Armor Set"
	quest.7B0000000000002E.quest_desc: ["Full set: Speed I, Jump Boost I, +1.5 block reach."]
	quest.7B0000000000002E.title: "Novice Builder Armor Set"
	quest.7B0000000000002F.quest_desc: ["Full set: immune to Voidflame."]
	quest.7B0000000000002F.title: "Voiderite Armor Set"
	quest.7B00000000000030.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B00000000000030.title: "Zoranths Helmet Set"
	quest.7B00000000000032.quest_desc: ["Helmet: Unbreakable and fire-proof; grants night vision, stops endermen aggroing from eye contact, and keeps piglins neutral. Full Infinity set (all 4 pieces): immune to all damage, cannot die, creative flight, plus permanent Speed, Jump Boost, Regeneration, Resistance, Absorption, and Fire Resistance. Chestplate: Unbreakable and fire-proof. Full Infinity set (all 4 pieces): immune to all damage, cannot die, creative flight, plus permanent Speed, Jump Boost, Regeneration, Resistance, Absorption, and Fire Resistance. Boots: Unbreakable and fire-proof. Full Infinity set (all 4 pieces): immune to all damage, cannot die, creative flight, plus permanent Speed, Jump Boost, Regeneration, Resistance, Absorption, and Fire Resistance."]
	quest.7B00000000000032.title: "Infinity Set"
	quest.7B00000000000033.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B00000000000033.title: "Aeternium Set"
	quest.7B00000000000034.quest_desc: ["Per piece while worn: Swiftness (boots), Dig Speed/Haste (chest), blindness resistance (helmet), +4 max health (leggings). Full set bonus: Regeneration I."]
	quest.7B00000000000034.title: "Crystalite Set"
	quest.7B00000000000035.quest_desc: ["Skull: Worn as a helmet: grants Night Vision; completes the Dragon Bones set (full set adds Strength and Resistance). Chestplate: On hit: ~10% chance to launch a blazing fireball at a close attacker. Adds a dodge-roll charge and reduced burn time; with the leggings, grants Speed and Fire Resistance while sneaking. Leggings: Adds a dodge-roll charge (Roll Count) and reduced burn time; with the chestplate, grants Speed and Fire Resistance while sneaking. Boots: On taking fall damage: emits a shockwave that damages nearby entities. Each piece also adds a dodge-roll charge (Roll Count) and reduces burn time; full set grants Strength and Resistance while worn."]
	quest.7B00000000000035.title: "Dragon Bones Set"
	quest.7B00000000000036.quest_desc: ["Cannot be removed once worn; you detonate (explode) when your health is low."]
	quest.7B00000000000036.title: "Damned Demomans Hat Set"
	quest.7B00000000000037.quest_desc: ["Full set: enter a rampage at low health and gain Wither Resistance."]
	quest.7B00000000000037.title: "Dark Metal Armor Set"
	quest.7B00000000000038.quest_desc: ["While worn: grants Jump Boost and Speed."]
	quest.7B00000000000038.title: "Killer Rabbit Ears Set"
	quest.7B00000000000039.quest_desc: ["While worn: enhances pumpkin weapons; immunity to fire and soul stratification; attackers are set ablaze with infernal fire."]
	quest.7B00000000000039.title: "Lord Pumpkinheads Hat Set"
	quest.7B0000000000003A.quest_desc: ["When a monster attacks you: summons a controlled baby skeleton and inflicts Magic Depletion on you."]
	quest.7B0000000000003A.title: "Missionary Hat Set"
	quest.7B0000000000003B.quest_desc: ["Full set: move faster in darkness and strengthen dark-magic weapons and items."]
	quest.7B0000000000003B.title: "Nightmare Mantleofthe Night Set"
	quest.7B0000000000003C.quest_desc: ["Each piece: attackers take retaliation damage. Full set: retaliation doubled and you take no spiny-shell (spike) damage."]
	quest.7B0000000000003C.title: "Spiny Shell Armor Set"
	quest.7B0000000000003D.quest_desc: ["While worn: strengthens baby skeletons summoned by the Bonescaller Staff."]
	quest.7B0000000000003D.title: "Spiritual Guide Sombrero Set"
	quest.7B0000000000003E.quest_desc: ["Helmet: Keybind: inflict Blazing Brand on the entity you target. While worn, lava-dwelling monsters won't target you unprovoked. Chestplate: Can be smithed with an elytra to form the Ignitium Elytra Chestplate. Chestplate: Chestplate fused with an elytra; grants elytra gliding. Leggings: Attackers that hit you are set on fire (Flame Reflex). Boots: Walk on the surface of lava; sneak to sink."]
	quest.7B0000000000003E.title: "Ignitium Set"
	quest.7B0000000000003F.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B0000000000003F.title: "Bone Reptile Set"
	quest.7B00000000000040.quest_desc: ["Per piece: helmet keybind glows entities through walls; chestplate revives you at 5 HP with 5s invincibility on death (then a 6-minute lockout); leggings give a chance to dodge attacks (more vs projectiles); boots reduce fall damage and keybind-dash backward. No combined set bonus."]
	quest.7B00000000000040.title: "Cursium Set"
	quest.7B00000000000041.quest_desc: ["While worn, dropping below half health knocks back nearby entities and grants regeneration plus temporary added defense and knockback resistance."]
	quest.7B00000000000041.title: "Monstrous Set"
	quest.7B00000000000042.quest_desc: ["Keybind: fire amethyst clusters around you that damage nearby entities."]
	quest.7B00000000000042.title: "Bloom Stone Pauldrons"
	quest.7B00000000000043.quest_desc: ["+10% abyssal spell power, +5% spell power, +125 max mana."]
	quest.7B00000000000043.title: "Abyssal Warlock Set"
	quest.7B00000000000044.quest_desc: ["+3 nature heal, +20% nature spell power, +10% spell power, +150 max mana."]
