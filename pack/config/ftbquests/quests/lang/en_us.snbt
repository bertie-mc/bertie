	quest.7B000000000001CE.quest_desc: ["Throwable like a trident; pre-enchanted with Impaling VI and ignores 25% of the target's armor."]
	quest.7B000000000001CE.title: "Malachite Bident"
	quest.7B000000000001CF.quest_desc: ["Comes pre-enchanted with Piercing V."]
	quest.7B000000000001CF.title: "Malachite Crossbow"
	quest.7B000000000001D0.quest_desc: ["Comes pre-enchanted with Sweeping Edge IV."]
	quest.7B000000000001D0.title: "Malachite Ultra Greatsword"
	quest.7B000000000001D1.quest_desc: ["Configurable multitool (pickaxe/axe/shovel/hoe) with a mode GUI (Silk Touch/Fortune, tool actions, Ink-powered area mining). Pre-enchanted with Fortune IV."]
	quest.7B000000000001D1.title: "Malachite Workstaff"
	quest.7B000000000001D2.quest_desc: ["One tool that mines and right-click-acts as pickaxe, axe, shovel and hoe. Pre-enchanted with Efficiency I."]
	quest.7B000000000001D2.title: "Multitool"
	quest.7B000000000001D3.quest_desc: ["Light greatsword that blocks and lunges. Its lunge consumes the target's status effects: detonating damage-over-time effects for bonus damage, auto-critting sleeping targets, or stealing their positive effects."]
	quest.7B000000000001D3.title: "Nectar Lance"
	quest.7B000000000001D4.quest_desc: ["Can be infused with a potion effect at a Potion Workshop; hits then apply that effect, consuming Ink."]
	quest.7B000000000001D4.title: "Nightfalls Blade"
	quest.7B000000000001D5.quest_desc: ["Comes pre-enchanted with Looting III."]
	quest.7B000000000001D5.title: "Razor Falchion"
	quest.7B000000000001D6.quest_desc: ["On hit: chance to spread holy water, forming a purity aura that grants you Strength and cures your negative effects."]
	quest.7B000000000001D6.title: "Ascended Idol"
	quest.7B000000000001D7.quest_desc: ["On hit: chance to steal a positive effect. Sneak: blast an explosive cannonball forward (can hurt you)."]
	quest.7B000000000001D7.title: "Black Pearl"
	quest.7B000000000001D8.quest_desc: ["While held: aura that slows and weakens enemies the longer they linger in it, but also slows you. Sneak: solidify for bonus armor while unable to move or attack; taking a hit reverts you and stuns enemies in the aura."]
	quest.7B000000000001D8.title: "Blade Of The Grotesque"
	quest.7B000000000001D9.quest_desc: ["On hit: chance to constrict (suffocate + slow). Sneak-dash launches a poison blast and grants speed."]
	quest.7B000000000001D9.title: "Boas Fang"
	quest.7B000000000001DA.quest_desc: ["On hit: chance to summon a steam jet that flings enemies up, but the weapon oxidizes and its swing speed drops to a halt; it deoxidizes over time, sometimes sparking to stun enemies."]
	quest.7B000000000001DA.title: "Brassturn"
	quest.7B000000000001DB.quest_desc: ["While held: minor thorns that deal bonus fire damage to burning attackers. Sneak: spin to fling flames around you, leaving you with nausea."]
	quest.7B000000000001DB.title: "Cindergorge"
	quest.7B000000000001DC.quest_desc: ["On hit: chance to extend Hex. Sneak: hex a target (duration scales with their positive effects and worsens over time), or expel an existing hex to gain temporary health."]
	quest.7B000000000001DC.title: "Culterex"
	quest.7B000000000001DD.quest_desc: ["On hit: chance to spread unholy water, forming a corruption aura that inflicts Wither and Weakness. Sneak: curse nearby enemies so they take extra damage and are blinded and heavily slowed when hit."]
	quest.7B000000000001DD.title: "Darksent"
	quest.7B000000000001DE.quest_desc: ["While held: gather up to 5 crows; on hit, chance to inflict bleed and add a crow (more crows = longer, harsher bleed). Sneak: command crows to swarm one target, blinding it and healing you from the damage."]
	quest.7B000000000001DE.title: "Deaths Eyrie"
	quest.7B000000000001DF.quest_desc: ["Breaks shields. On hit: chance to inflict stacking Armor Crunch (reduces the target's armor). Sneak: charge and slam to launch, weaken, slow, and Armor-Crunch nearby enemies."]
	quest.7B000000000001DF.title: "Earthshatter"
	quest.7B000000000001E0.quest_desc: ["On hit: builds heat and has a chance (higher while mounted) to cause tremors that slow and mining-fatigue nearby foes; at full heat the next attack explodes and flings enemies. Sneak: hurl rocks that shatter to briefly stun."]
	quest.7B000000000001E0.title: "Exedrill"
	quest.7B000000000001E1.quest_desc: ["On hit: chance (higher while mounted) to gain Starlight stacks that grant random speed bursts. Sneak: consume all stacks to explode for damage scaling with stacks (also hits you and allies, for less)."]
	quest.7B000000000001E1.title: "Glimmerstep"
	quest.7B000000000001E2.quest_desc: ["On hit: chance to chill; blocking enemies are always frozen. Sneak: conjure a gale that knocks back nearby enemies, chilling and heavily slowing them."]
	quest.7B000000000001E2.title: "Grandfrost"
	quest.7B000000000001E3.quest_desc: ["On hit: chance to poison, or inflict venom if the target is already poisoned. Sneak: summon a cone of fangs that inflict venom and heavily slow."]
	quest.7B000000000001E3.title: "Great Slither"
	quest.7B000000000001E4.quest_desc: ["On hit: chance to spread holy water, forming a purity aura granting Regeneration and curing your negative effects. Sneak: bless yourself and nearby allies so the next damage taken is nullified and heals instead."]
	quest.7B000000000001E4.title: "Holylight"
	quest.7B000000000001E5.quest_desc: ["While held in the main hand: grants Speed, Strength, and Haste."]
	quest.7B000000000001E5.title: "Jester Penetrate"
	quest.7B000000000001E6.quest_desc: ["On hit: chance to apply stacking Radiant Mark; each hit deals bonus true damage equal to its level. Sneak: teleport to the nearest marked foe and erupt light to damage and knock back enemies (self-stun after)."]
	quest.7B000000000001E6.title: "Lustrous Moxie"
	quest.7B000000000001E7.quest_desc: ["On hit: chance to fire a beta particle that pierces walls and shields for damage. Sneak: spawn a rift that makes enemies within 10 blocks glow, slows them, and pulls them back if they try to leave."]
	quest.7B000000000001E7.title: "Matterbane"
	quest.7B000000000001E8.quest_desc: ["Shape-shifting Mimicry weapon (Backhand Blade form). Sneak: dash forward and stab, then rush back to your spot, inflicting blindness."]
	quest.7B000000000001E8.title: "Mimicry Backhand Blade"
	quest.7B000000000001E9.quest_desc: ["Shape-shifting Mimicry weapon (Chakram form). Sneak: greatly boost your movement and attack speed for a short time."]
	quest.7B000000000001E9.title: "Mimicry Chakram"
	quest.7B000000000001EA.quest_desc: ["Shape-shifting Mimicry weapon (Claymore form). Sneak: leap forward and slam, knocking back and heavily slowing and weakening enemies."]
	quest.7B000000000001EA.title: "Mimicry Claymore"
	quest.7B000000000001EB.quest_desc: ["Shape-shifting Mimicry weapon (Cutlass form). Sneak: sweeping slash that pulls enemies in and pierces shields."]
	quest.7B000000000001EB.title: "Mimicry Cutlass"
	quest.7B000000000001EC.quest_desc: ["Shape-shifting Mimicry weapon (Dagger form). Sneak: slash forward then jump back, gaining invisibility if you hit an enemy."]
	quest.7B000000000001EC.title: "Mimicry Dagger"
	quest.7B000000000001ED.quest_desc: ["Shape-shifting Mimicry weapon (Deer Horns form). Sneak: leap back with slow falling, slashing around you until you land; gain speed on hitting an enemy."]
	quest.7B000000000001ED.title: "Mimicry Deer Horns"
	quest.7B000000000001EE.quest_desc: ["Shape-shifting Mimicry weapon (Glaive form). Sneak: quick slash that ignores shields and dismounts enemies."]
	quest.7B000000000001EE.title: "Mimicry Glaive"
	quest.7B000000000001EF.quest_desc: ["Shape-shifting Mimicry weapon (Grandsword form). Sneak: rush forward slashing around you, gaining Strength and breaking shields."]
	quest.7B000000000001EF.title: "Mimicry Grandsword"
	quest.7B000000000001F0.quest_desc: ["Shape-shifting Mimicry weapon (Great Katana form). Sneak: teleport and slash a nearby foe; other nearby enemies are also slashed for less."]
	quest.7B000000000001F0.title: "Mimicry Great Katana"
	quest.7B000000000001F1.quest_desc: ["Shape-shifting Mimicry weapon (Great Spear form). Sneak: slam to fatigue and launch enemies upward, then stab forward to push them away."]
	quest.7B000000000001F1.title: "Mimicry Great Spear"
	quest.7B000000000001F2.quest_desc: ["Shape-shifting Mimicry weapon (Greataxe form). Sneak: slash around you, breaking shields and flinging enemies away."]
	quest.7B000000000001F2.title: "Mimicry Greataxe"
	quest.7B000000000001F3.quest_desc: ["Shape-shifting Mimicry weapon (Greathammer form). Sneak: slam down twice, breaking shields and inflicting heavy slowness and weakness."]
	quest.7B000000000001F3.title: "Mimicry Greathammer"
	quest.7B000000000001F4.quest_desc: ["Shape-shifting Mimicry weapon (Halberd form). Sneak: slash around you, then dash forward slashing; both apply heavy bleed."]
	quest.7B000000000001F4.title: "Mimicry Halberd"
	quest.7B000000000001F5.quest_desc: ["Shape-shifting Mimicry weapon (Katana form). Sneak: teleport forward, leaving damaging slashes in your path."]
	quest.7B000000000001F5.title: "Mimicry Katana"
	quest.7B000000000001F6.quest_desc: ["Shape-shifting Mimicry weapon (Khopesh form). Sneak: rush forward and slash, gaining intense speed on hitting an enemy."]
	quest.7B000000000001F6.title: "Mimicry Khopesh"
	quest.7B000000000001F7.quest_desc: ["Shape-shifting Mimicry weapon (Lance form). Sneak: leap forward and stab twice — the first heavily slows, the second greatly knocks back."]
	quest.7B000000000001F7.title: "Mimicry Lance"
	quest.7B000000000001F8.quest_desc: ["Shape-shifting Mimicry weapon (Longsword form). Sneak: sweeping slash that knocks back, dealing more damage the more enemies it hits."]
	quest.7B000000000001F8.title: "Mimicry Longsword"
	quest.7B000000000001F9.quest_desc: ["Shape-shifting Mimicry weapon (Pernach form). Sneak: three forward slashes — the first two disable shields, the third applies slowness, weakness, and bleed."]
	quest.7B000000000001F9.title: "Mimicry Pernach"
	quest.7B000000000001FA.quest_desc: ["Shape-shifting Mimicry weapon (Quarterstaff form). Sneak: leap up and slam down, hitting enemies into the air."]
	quest.7B000000000001FA.title: "Mimicry Quarterstaff"
	quest.7B000000000001FB.quest_desc: ["Shape-shifting Mimicry weapon (Rapier form). Sneak: five rapid stabs; the first and last cause bleed."]
	quest.7B000000000001FB.title: "Mimicry Rapier"
	quest.7B000000000001FC.quest_desc: ["Shape-shifting Mimicry weapon (Sai form). Sneak: three rapid stabs applying blindness and bleed."]
	quest.7B000000000001FC.title: "Mimicry Sai"
	quest.7B000000000001FD.quest_desc: ["Shape-shifting Mimicry weapon (Scythe form). Sneak: dash forward with three wide swings, each inflicting wither."]
	quest.7B000000000001FD.title: "Mimicry Scythe"
	quest.7B000000000001FE.quest_desc: ["Shape-shifting Mimicry weapon (Spear form). Sneak: three stabs inflicting slowness; the final is stronger and breaks shields."]
	quest.7B000000000001FE.title: "Mimicry Spear"
	quest.7B000000000001FF.quest_desc: ["Shape-shifting Mimicry weapon (Twinblade form). Sneak: two spinning slashes — the first slows, the second knocks back."]
	quest.7B000000000001FF.title: "Mimicry Twinblade"
	quest.7B00000000000200.quest_desc: ["Shape-shifting Mimicry weapon (Warglaive form). Sneak: spinning slash, then rush forward and slash again; both apply slowness."]
	quest.7B00000000000200.title: "Mimicry Warglaive"
	quest.7B00000000000201.quest_desc: ["On hit: chance to erupt damaging lava around you. Sneak: empower your next swing to strike much faster and erupt more fiercely."]
	quest.7B00000000000201.title: "Molten Flare"
	quest.7B00000000000202.quest_desc: ["While held: the hungrier you are, the more Speed and damage you gain. Sneak: grasp a foe to drain their hunger and health into your own bars and inflict Weakness and Mining Fatigue, then spit them away (you cannot attack while grasping)."]
	quest.7B00000000000202.title: "Myrmedge"
	quest.7B00000000000203.quest_desc: ["On hit: gain Bloom stacks (max 15) that progressively buff your defenses. Sneak: spend 8 stacks to create a flower field that buffs allies inside it."]
	quest.7B00000000000203.title: "Perforiscus"
	quest.7B00000000000204.quest_desc: ["While held: the more health you are missing, the more damage you deal; chance on hit to inflict bleed. Sneak: charge for one of three escalating attacks whose range and damage scale with your missing health."]
	quest.7B00000000000204.title: "Revvengine"
	quest.7B00000000000205.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B00000000000205.title: "Runic Backhand Blade"
	quest.7B00000000000206.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B00000000000206.title: "Runic Dagger"
	quest.7B00000000000207.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B00000000000207.title: "Runic Deer Horns"
	quest.7B00000000000208.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B00000000000208.title: "Runic Grandsword"
	quest.7B00000000000209.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B00000000000209.title: "Runic Great Katana"
	quest.7B0000000000020A.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B0000000000020A.title: "Runic Great Spear"
	quest.7B0000000000020B.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B0000000000020B.title: "Runic Khopesh"
	quest.7B0000000000020C.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B0000000000020C.title: "Runic Lance"
	quest.7B0000000000020D.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B0000000000020D.title: "Runic Pernach"
	quest.7B0000000000020E.quest_desc: ["Rune socket: a socketed runefused gem grants a random combat-triggered runic power; craft and re-roll with a Runic Tablet."]
	quest.7B0000000000020E.title: "Runic Quarterstaff"
	quest.7B0000000000020F.quest_desc: ["No special properties (vanilla-equivalent stats only)."]
	quest.7B0000000000020F.title: "Ruptured Idol"
	quest.7B00000000000210.quest_desc: ["Sneak: charge a slam that grows the weapon the longer it charges, increasing the blow's damage and range."]
	quest.7B00000000000210.title: "Ruyi Jingu Bang"
	quest.7B00000000000211.quest_desc: ["On hit: +4 damage if the target has poison or venom. Sneak: summon 4 homing poison bolts that chase down enemies."]
	quest.7B00000000000211.title: "Serpentine Valour"
	quest.7B00000000000212.quest_desc: ["On hit: chance to inflict Wither, adding a level of Withering Fate if the target already has it. Sneak: leap back into mist, then teleport to a target within 10 blocks ahead, leaving a slash that inflicts Withering Fate (reduced max HP)."]
	quest.7B00000000000212.title: "Smouldering Ruin"
	quest.7B00000000000213.quest_desc: ["On hit: chance to steal a target's soul, draining their positive effects much faster until it returns. Sneak: return the soul early to blind, slow, and teleport the target to you."]
	quest.7B00000000000213.title: "Soul Foreseer"
	quest.7B00000000000214.quest_desc: ["On hit: chance to shock, putting the enemy's abilities on cooldown for a few seconds. Sneak: charge to erupt lightning around you (harmless to you)."]
	quest.7B00000000000214.title: "Stasis"
	quest.7B00000000000215.quest_desc: ["On hit: chance to spread unholy water, forming a corruption aura that inflicts Wither and Weakness."]
	quest.7B00000000000215.title: "Tarnished Idol"
	quest.7B00000000000216.quest_desc: ["Lifesteal on hit. Sneak: enter a harvest that boosts lifesteal, grants Speed and Haste, inflicts bleed on hit, and lets you sense nearby entities."]
	quest.7B00000000000216.title: "The Blood Harvester"
	quest.7B00000000000217.quest_desc: ["On hit: chance to knock the enemy back."]
	quest.7B00000000000217.title: "The Pan"
	quest.7B00000000000218.quest_desc: ["Lifesteal on hit. Sneak: cut yourself for a share of your health to enter a rage — you bleed but take no other damage, gain extra lifesteal and damage, and inflict bleed."]
	quest.7B00000000000218.title: "The Vessel Breach"
	quest.7B00000000000219.quest_desc: ["On hit: chance to summon rainfall that inflicts insanity (random head movement, Weakness, Slowness). Sneak: swap places with the last enemy you hit, if hit recently and within range."]
	quest.7B00000000000219.title: "Tidebreaker"
	quest.7B0000000000021A.quest_desc: ["Effect changes with time of day. Day — on hit: chance to make entities within 30 blocks glow; Sneak: blast a solar flare that blinds, burns, and knocks back. Night — on hit: chance to gain Speed and invisibility and inflict Darkness; Sneak: blast a gravity surge that launches and heavily slows foes. Cooldown shrinks nearer noon/midnight; in timeless dimensions both on-hit effects can trigger."]
	quest.7B0000000000021A.title: "Timekeeper"
	quest.7B0000000000021B.quest_desc: ["While held in the main hand: expiring status effects persist at their weakest level until you unequip. Sneak: summon a ring around you that damages and poisons enemies."]
	quest.7B0000000000021B.title: "Vipers Call"
	quest.7B0000000000021C.quest_desc: ["On hit: chance to levitate the target. Right-click: lift nearby enemies with damage-over-time, then slam them to the ground."]
	quest.7B0000000000021C.title: "Arcanethyst"
	quest.7B0000000000021D.quest_desc: ["Soul aura damages nearby enemies; right-click sends souls to strike a distant target (rapid hits, health siphon), then return granting absorption. Soul Anguish tier III (max)."]
	quest.7B0000000000021D.title: "Awakened Lichblade"
	quest.7B0000000000021E.quest_desc: ["On hit: chance to release orbiting toxic spores that inflict escalating effects on nearby enemies while a target stays in range."]
	quest.7B0000000000021E.title: "Bramblethorn"
	quest.7B0000000000021F.quest_desc: ["On hit: chance to spew explosive brimstone."]
	quest.7B0000000000021F.title: "Brimstone Claymore"
	quest.7B00000000000220.quest_desc: ["While wielded: chance to fully avoid incoming damage. Right-click: become briefly immune to damage, then release an explosion scaling with the damage negated."]
	quest.7B00000000000220.title: "Caelestis"
	quest.7B00000000000221.quest_desc: ["On hit: summon axolotls that attack enemies and can perch on your shoulders for area buffs (can grant Dolphin's Grace). Right-click: summon a rare blue axolotl."]
	quest.7B00000000000221.title: "Chompolotl"
	quest.7B00000000000222.quest_desc: ["No combat effect. Carrying it while exploring the deepest, darkest Overworld depths transforms it into a random unique weapon."]
	quest.7B00000000000222.title: "Decaying Relic"
	quest.7B00000000000223.quest_desc: ["No combat effect. A crafting relic: upgrade with a Runic Tablet into the Righteous or Tainted Relic (then Sunfire/Harbinger)."]
	quest.7B00000000000223.title: "Dormant Relic"
	quest.7B00000000000224.quest_desc: ["Right-click (channel): release fiery shrapnel at the nearest target, more damage the longer charged (a last-second release adds an extra shard); channeling may grant Speed, Haste, and Strength."]
	quest.7B00000000000224.title: "Emberblade"
	quest.7B00000000000225.quest_desc: ["On hit: inflict Smouldering; striking Smouldering enemies deals bonus damage per stack. Right-click: evade backwards and heal a percentage of max HP."]
	quest.7B00000000000225.title: "Emberlash"
	quest.7B00000000000226.quest_desc: ["Right-click: summon a twister that chases enemies, dealing more damage the longer they stay trapped; gain Haste while near it."]
	quest.7B00000000000226.title: "Enigma"
	quest.7B00000000000227.quest_desc: ["Right-click: plant a flame seed in the nearest enemy (damage-over-time) that detonates for area damage and spreads to others; gain Haste on each detonation."]
	quest.7B00000000000227.title: "Flamewind"
	quest.7B00000000000228.quest_desc: ["Right-click to throw (innate Loyalty III); airtime and angle scale impact damage. On landing it pulses 5 times, damaging, slowing, and pulling nearby enemies."]
	quest.7B00000000000228.title: "Frostfall"
	quest.7B00000000000229.quest_desc: ["On hit: chance to inflict Weakness. Right-click: summon an Abyssal Battle Standard that pulls, damages, and slows enemies while periodically granting Haste to nearby allies."]
	quest.7B00000000000229.title: "Harbinger"
	quest.7B0000000000022A.quest_desc: ["On hit: chance to ignite the target and send it flying. Right-click (channel): trade health for resistance while tremors pull enemies in; release to launch and ignite them, scaling with channel time."]
	quest.7B0000000000022A.title: "Hearthflame"
	quest.7B0000000000022B.quest_desc: ["On hit: release a bee that stings the target (limited frequency). Right-click: have your bees produce healing honey, regenerating you over time."]
	quest.7B0000000000022B.title: "Hiveheart"
	quest.7B0000000000022C.quest_desc: ["While wielded: a frost aura damages and slows nearby enemies. Right-click: drain hunger to summon a blizzard that slows and deals extra damage around you."]
	quest.7B0000000000022C.title: "Icewhisper"
	quest.7B0000000000022D.quest_desc: ["Right-click to throw (innate Loyalty III); airtime and angle scale impact damage. On return it slows and damages enemies."]
	quest.7B0000000000022D.title: "Livyatan"
	quest.7B0000000000022E.quest_desc: ["Occasionally repels approaching enemies. Right-click: after a short delay, release a sonic boom that damages enemies in its path."]
	quest.7B0000000000022E.title: "Magiblade"
	quest.7B0000000000022F.quest_desc: ["Right-click: summon a localized storm that damages nearby enemies and can refresh and intensify itself; attacking during it has a chance to repair an equipped item."]
	quest.7B0000000000022F.title: "Magiscythe"
	quest.7B00000000000230.quest_desc: ["Right-click to throw (innate Loyalty III), leaping forward into a slam that damages nearby enemies (immune while leaping). On hit: chance for bonus magic damage."]
	quest.7B00000000000230.title: "Magispear"
	quest.7B00000000000231.quest_desc: ["When raining/wet, on hit: chance to call down lightning. Right-click (channel): gain resistance and create a local storm that rains lightning on nearby enemies."]
	quest.7B00000000000231.title: "Mjolnir"
	quest.7B00000000000232.quest_desc: ["On hit: chance to ignite the target or yourself (Regeneration instead if low HP); gain Strength and Speed the lower your HP. Right-click: roar to knock back and ignite nearby enemies, gaining resistance and onslaught."]
	quest.7B00000000000232.title: "Molten Edge"
	quest.7B00000000000233.quest_desc: ["While wielded: move 5% slower but take 15% less damage. Right-click: dash forward, shrugging off the next few hits and gaining knockback resistance; your next attack deals +95% to a single target."]
	quest.7B00000000000233.title: "Ribboncleaver"
	quest.7B00000000000234.quest_desc: ["On hit: chance to gain Regeneration. Upgrades with a Runic Tablet into Sunfire."]
	quest.7B00000000000234.title: "Righteous Relic"
	quest.7B00000000000235.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000235.title: "Runic Chakram"
	quest.7B00000000000236.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000236.title: "Runic Claymore"
	quest.7B00000000000237.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000237.title: "Runic Cutlass"
	quest.7B00000000000238.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000238.title: "Runic Glaive"
	quest.7B00000000000239.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000239.title: "Runic Greataxe"
	quest.7B0000000000023A.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B0000000000023A.title: "Runic Greathammer"
	quest.7B0000000000023B.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B0000000000023B.title: "Runic Halberd"
	quest.7B0000000000023C.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B0000000000023C.title: "Runic Katana"
	quest.7B0000000000023D.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B0000000000023D.title: "Runic Longsword"
	quest.7B0000000000023E.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B0000000000023E.title: "Runic Rapier"
	quest.7B0000000000023F.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B0000000000023F.title: "Runic Sai"
	quest.7B00000000000240.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000240.title: "Runic Scythe"
	quest.7B00000000000241.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000241.title: "Runic Spear"
	quest.7B00000000000242.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000242.title: "Runic Twinblade"
	quest.7B00000000000243.quest_desc: ["Has a rune socket: socket a runefused gem for a random on-hit runic power; gems are identified and re-rolled with a Runic Tablet."]
	quest.7B00000000000243.title: "Runic Warglaive"
	quest.7B00000000000244.quest_desc: ["On hit: chance to deal magic damage that scales with the target's armor. Right-click: drop a blinding shadow mist and shadowstep forward."]
	quest.7B00000000000244.title: "Shadowsting"
	quest.7B00000000000245.quest_desc: ["Soul aura damages nearby enemies; right-click sends souls to strike a distant target (rapid hits, health siphon), then return granting absorption. Soul Anguish tier I of III (upgrades to Waking, then Awakened)."]
	quest.7B00000000000245.title: "Slumbering Lichblade"
	quest.7B00000000000246.quest_desc: ["On hit: chance to absorb souls, gaining toughness but reduced attack speed. Right-click: release the souls, passing the attack-speed slow to nearby foes and regenerating you."]
	quest.7B00000000000246.title: "Soulkeeper"
	quest.7B00000000000247.quest_desc: ["Right-click: form an expanding zone that pulses to heal you and damage enemies; while active, gain knockback resistance and take 50% less damage."]
	quest.7B00000000000247.title: "Soulpyre"
	quest.7B00000000000248.quest_desc: ["On hit: chance to inflict stacking weakness. Right-click: consume all stacks from nearby foes, damaging them and healing you per stack consumed."]
	quest.7B00000000000248.title: "Soulrender"
	quest.7B00000000000249.quest_desc: ["On hit: chance to steal the target's soul, gaining Haste while slowing and marking it for death. Right-click: near a soulless target, return its soul, leap, and gain invisibility; from afar, blink to it, returning the soul with force to blind and damage."]
	quest.7B00000000000249.title: "Soulstealer"
	quest.7B0000000000024A.quest_desc: ["By day, attacks deal bonus damage; by night, attacks gain lifesteal. Right-click: evade backwards gaining Speed; activate again to dash forward with resistance and Haste."]
	quest.7B0000000000024A.title: "Stars Edge"
	quest.7B0000000000024B.quest_desc: ["Right-click: briefly block incoming attacks; timing the block against an enemy swing parries, dealing damage, launching them, and cutting the cooldown. Consecutive parries scale up."]
	quest.7B0000000000024B.title: "Stormbringer"
	quest.7B0000000000024C.quest_desc: ["On hit: chance to refresh the ability cooldown. Right-click: jolt forward with brief invulnerability and lingering Speed and Haste."]
	quest.7B0000000000024C.title: "Storms Edge"
	quest.7B0000000000024D.quest_desc: ["On hit: chance to gain Regeneration. Right-click: summon a Righteous Battle Standard that ignites, damages, and slows enemies while periodically granting Strength and health to nearby allies."]
	quest.7B0000000000024D.title: "Sunfire"
	quest.7B0000000000024E.quest_desc: ["Right-click to throw it at enemies. No other special effect."]
	quest.7B0000000000024E.title: "Sword On A Stick"
	quest.7B0000000000024F.quest_desc: ["On hit: chance to inflict Weakness. Upgrades with a Runic Tablet into Harbinger."]
	quest.7B0000000000024F.title: "Tainted Relic"
	quest.7B00000000000250.quest_desc: ["On hit: attach stacking elemental energy (damage-over-time plus element-specific debuffs). Right-click: draw nearby elements into a growing vortex around you that damages enemies."]
	quest.7B00000000000250.title: "Tempest"
	quest.7B00000000000251.quest_desc: ["On hit: chance to refresh the ability cooldown. Right-click: charge up, damaging nearby foes, then dash forward with Haste, dealing heavy damage to enemies in your path."]
	quest.7B00000000000251.title: "Thunderbrand"
	quest.7B00000000000252.quest_desc: ["On hit: chance to convert the target's positive potion effects into their negative counterparts."]
	quest.7B00000000000252.title: "Toxic Longsword"
	quest.7B00000000000253.quest_desc: ["On hit: chance to gain stacking attack speed (up to 15). Right-click: consume all stacks for Strength lasting as long as the number of stacks consumed."]
	quest.7B00000000000253.title: "Twisted Blade"
	quest.7B00000000000254.quest_desc: ["Soul aura damages nearby enemies; right-click sends souls to strike a distant target (rapid hits, health siphon), then return granting absorption. Soul Anguish tier II of III (upgrades to Awakened)."]
	quest.7B00000000000254.title: "Waking Lichblade"
	quest.7B00000000000255.quest_desc: ["On hit: chance to rip life from a low-HP target for absorption, instantly executing those under a health threshold; separate chance to siphon health from nearby enemies to heal you."]
	quest.7B00000000000255.title: "Watcher Claymore"
	quest.7B00000000000256.quest_desc: ["On hit: chance to rip life from a low-HP target for absorption, instantly executing those under a health threshold; separate chance to siphon health from nearby enemies to heal you."]
	quest.7B00000000000256.title: "Watching Warglaive"
	quest.7B00000000000257.quest_desc: ["Attacking ignited enemies grants Strength and Haste. Once per long cooldown, otherwise-lethal damage instead heals you to full and grants brief resistance (mainhand only)."]
	quest.7B00000000000257.title: "Waxweaver"
	quest.7B00000000000258.quest_desc: ["On hit: chance to refresh the ability cooldown. Right-click: dash forward gaining resistance and absorption, inflicting Echo on enemies in your path (stronger per enemy hit)."]
	quest.7B00000000000258.title: "Whisperwind"
	quest.7B00000000000259.quest_desc: ["Right-click to throw (innate Loyalty III), gaining frenzy stacks that grant attack speed and let you hit twice (max 5, lost when you take a hit)."]
	quest.7B00000000000259.title: "Wickpiercer"
	quest.7B0000000000025A.quest_desc: ["Right-click to throw (innate Loyalty I) and leap to it with brief damage immunity, gaining Haste on arrival."]
	quest.7B0000000000025A.title: "Wraithfang"
	quest.7B0000000000025B.quest_desc: ["Arrows swap your position with whatever they hit."]
	quest.7B0000000000025B.title: "Ender Bow"
	quest.7B0000000000025C.quest_desc: ["Sets targets on fire on hit."]
	quest.7B0000000000025C.title: "Fiery Sword"
	quest.7B0000000000025D.quest_desc: ["+2.5 blocks of attack and block reach."]
	quest.7B0000000000025D.title: "Giant Sword"
	quest.7B0000000000025E.quest_desc: ["Breaks after a single hit; flagged Creative-Mode-only in this version."]
	quest.7B0000000000025E.title: "Glass Sword"
	quest.7B0000000000025F.quest_desc: ["Arrows chill targets, slowing them."]
	quest.7B0000000000025F.title: "Ice Bow"
	quest.7B00000000000260.quest_desc: ["Chills targets on hit, slowing them."]
	quest.7B00000000000260.title: "Ice Sword"
	quest.7B00000000000261.quest_desc: ["Built-in Knockback I."]
	quest.7B00000000000261.title: "Ironwood Sword"
	quest.7B00000000000262.quest_desc: ["Deals extra damage to armored targets."]
	quest.7B00000000000262.title: "Knightmetal Sword"
	quest.7B00000000000263.quest_desc: ["Arrows home in on the target."]
	quest.7B00000000000263.title: "Seeker Bow"
	quest.7B00000000000264.quest_desc: ["Built-in Looting II."]
	quest.7B00000000000264.title: "Steeleaf Sword"
	quest.7B00000000000265.quest_desc: ["Fires three arrows at once in a spread."]
