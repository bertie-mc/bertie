# Build and tool output.
build/
out/
# Gradle dev-run working directories: runClient, runServer, runData. Wildcarded on
# purpose - a per-mod list drifts the moment a mod is renamed, and the stale entry then
# reads as somebody's uncommitted work.
/mods/*/run/
result
result-*
.bertie-ci/
.gradle/
.kotlin/
.pytest_cache/
.ruff_cache/
__pycache__/
*.egg-info/
*.log
*.py[cod]

# Local environments and editor metadata.
.direnv/
.idea/
.vscode/
.settings/
.venv/
*.classpath
*.iml
*.project

# Local asset-authoring inputs and caches, never redistributed.
# /mods/carving/ is a scratch area, not a mod - decompiled reference and render output
# only, no source. Ignored whole; the slag-ref entry that used to sit under
# berlords-carving moved here and its old path no longer exists.
/mods/carving/texture-work/
/mods/berlords-food-system/texture-work/vanilla/
/mods/berlords-food-system/texture-work/materials/
/mods/bertie-progression/texture-work/drafts/
/mods/primitive-refined/tools/extracted/

# Packwiz cache.
.packwizcache/

# Operating-system metadata.
.DS_Store
Thumbs.db
